---
// Ein Foto über <Picture> (AVIF + WebP, responsive Breiten) oder, ohne Bild, eine ruhige Fläche ohne Text.
// Seitenverhältnis und Radius setzt der Kontext über die Klasse .bild.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  bild?: ImageMetadata;
  /** Leer lassen, wenn der Link daneben das Bild schon benennt (Listen, Karten, Kacheln). */
  alt?: string;
  breiten: number[];
  sizes: string;
  /** Sofort laden, nur für das Hauptbild oben auf der Seite. */
  sofort?: boolean;
  class?: string;
}

const { bild, alt = '', breiten, sizes, sofort = false, class: klasse } = Astro.props;
// Nie größer rechnen als das Original
const passend = bild ? [...new Set(breiten.map((b) => Math.min(b, bild.width)))] : [];
---

{
  bild ? (
    <Picture
      src={bild}
      alt={alt}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={passend}
      sizes={sizes}
      loading={sofort ? 'eager' : 'lazy'}
      fetchpriority={sofort ? 'high' : undefined}
      class:list={['bild', klasse]}
    />
  ) : (
    <span class:list={['bild', klasse]} aria-hidden="true" />
  )
}
