---
// Footer: ein kleiner Player (Plattenteller, Titel, Play/Pause, Schalter für die fliegende Platte),
// darunter die Plattformen als Icons und Rechtliches.
// Platte und Play-Knopf schalten über src/lib/musik.js dieselbe Musik wie die fliegende Platte.
import { Image } from 'astro:assets';
import gesicht from '../assets/bilder/johannes-gesicht.jpg';
import Icon from './Icon.astro';
import { einstellungen, plattformen } from '../lib/inhalt';

const site = await einstellungen();
const song = site.plattenteller;
const links = plattformen(site.links);
---

<footer class="rahmen">
  <div class="fuss">
    <div class="spieler">
      <button class="platte" type="button" aria-label="Song abspielen" data-platte>
        <span class="scheibe">
          <Image class="etikett" src={gesicht} alt="" width={132} height={132} loading="lazy" />
          <span class="spindel"></span>
        </span>
        <span class="glanz"></span>
      </button>
      <div class="spieler-text">
        {
          song.datei ? (
            <>
              <p class="spieler-titel">
                {song.titel}
                <span class="eq" aria-hidden="true">
                  <i />
                  <i />
                  <i />
                </span>
              </p>
              {song.interpret && <p class="spieler-von">{song.interpret}</p>}
            </>
          ) : (
            <p class="spieler-titel">Rise and Shine</p>
          )
        }
      </div>
      <div class="spieler-knoepfe">
        {
          song.datei && (
            <button class="icon-knopf spielen" type="button" aria-label="Song abspielen" data-platte>
              <Icon name="abspielen" class="zeichen-aus" />
              <Icon name="pause" class="zeichen-an" />
            </button>
          )
        }
        {
          song.datei && song.fliegende_platte && (
            <button
              class="icon-knopf"
              type="button"
              role="switch"
              aria-checked="true"
              aria-label="Fliegende Platte"
              title="Fliegende Platte ein- und ausblenden"
              data-flieger-schalter
              hidden
            >
              <Icon name="platte" />
            </button>
          )
        }
      </div>
    </div>
    {
      links.length > 0 && (
        <ul class="sozial">
          {links.map((l) => (
            <li>
              <a class="icon-knopf" href={l.href} rel="me" aria-label={l.name} title={l.name}>
                <Icon name={l.icon} />
              </a>
            </li>
          ))}
        </ul>
      )
    }
    <p class="klein">
      <span>© {new Date().getFullYear()} {site.name}</span>
      <a href="/impressum/">Impressum</a>
      <a href="/datenschutz/">Datenschutz</a>
    </p>
  </div>
</footer>

<style>
  .fuss {
    display: grid;
    grid-template-columns: minmax(0, 420px) auto;
    align-items: center;
    justify-content: space-between;
    gap: 24px 40px;
    padding-block: clamp(32px, 4cqi, 48px) clamp(28px, 4cqi, 44px);
  }

  /* Player */
  .spieler {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 12px 12px 12px;
    border-radius: var(--r-gross);
    background: var(--flaeche);
  }
  .platte {
    position: relative;
    flex: none;
    width: 64px;
    height: 64px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #1b1b1a;
    cursor: pointer;
  }
  .platte .spindel {
    width: 6px;
    height: 6px;
    margin: -3px 0 0 -3px;
  }
  .spieler-text {
    flex: 1;
    min-width: 0;
  }
  .spieler-titel {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow: hidden;
    font-weight: 600;
    font-size: 16px;
    line-height: 1.25;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .spieler-von {
    margin-top: 2px;
    font-size: 14px;
    color: var(--leise);
  }
  .spieler-knoepfe {
    display: flex;
    flex: none;
    gap: 6px;
  }
  .spieler .icon-knopf {
    background: var(--grund);
  }
  .spieler .icon-knopf[aria-checked='true'] {
    background: var(--text);
    color: var(--grund);
  }
  @media (hover: hover) {
    .spieler .icon-knopf:hover {
      background: var(--text);
      color: var(--grund);
    }
  }
  .spieler .icon-knopf[hidden] {
    display: none;
  }
  /* Play oder Pause, je nach Zustand (data-laeuft setzt musik.js). :global, weil die Icons
     aus Icon.astro kommen und den Scope dieser Komponente nicht tragen. */
  .spielen :global(.zeichen-an),
  .spielen[data-laeuft='ja'] :global(.zeichen-aus) {
    display: none;
  }
  .spielen[data-laeuft='ja'] :global(.zeichen-an) {
    display: inline-flex;
  }
  /* Equalizer neben dem Titel, solange Musik läuft */
  .eq {
    display: inline-flex;
    flex: none;
    align-items: flex-end;
    gap: 2px;
    height: 12px;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .eq i {
    width: 3px;
    height: 100%;
    border-radius: 1px;
    background: var(--orange);
    transform-origin: bottom;
    animation: eq 0.9s ease-in-out infinite;
    animation-play-state: paused;
  }
  .eq i:nth-child(2) {
    animation-delay: -0.3s;
  }
  .eq i:nth-child(3) {
    animation-delay: -0.6s;
  }
  @keyframes eq {
    0%,
    100% {
      transform: scaleY(0.3);
    }
    50% {
      transform: scaleY(1);
    }
  }
  .spieler:has([data-laeuft='ja']) .eq {
    opacity: 1;
  }
  .spieler:has([data-laeuft='ja']) .eq i {
    animation-play-state: running;
  }
  @media (prefers-reduced-motion: reduce) {
    .eq i {
      animation: none;
      transform: scaleY(0.7);
    }
  }

  .sozial {
    justify-content: flex-end;
  }
  .klein {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    font-size: 14px;
    color: var(--leise);
  }
  .klein a {
    display: inline-block;
    padding-block: 12px;
    margin-block: -12px;
    text-decoration: none;
  }
  .klein a:hover {
    text-decoration: underline;
    text-decoration-color: var(--orange);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  @container (max-width: 760px) {
    .fuss {
      grid-template-columns: minmax(0, 1fr);
    }
    .sozial {
      justify-content: flex-start;
    }
  }
</style>
