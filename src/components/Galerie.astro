---
// Galerie: 3 Spalten, quadratisch. Ein Klick öffnet das Bild groß in einem <dialog>
// (Escape und „Schließen“). Ohne JavaScript öffnet der Link einfach das große Bild.
import { getImage } from 'astro:assets';
import Foto from './Foto.astro';
import type { Beitrag } from '../lib/inhalt';

interface Props {
  bilder: Beitrag['data']['galerie'];
}

const { bilder } = Astro.props;
const eintraege = await Promise.all(
  bilder.map(async (eintrag) => ({
    ...eintrag,
    gross: (await getImage({ src: eintrag.bild, width: Math.min(1600, eintrag.bild.width), format: 'webp' })).src,
  })),
);
---

<ul class="liste galerie">
  {
    eintraege.map(({ bild, alt, gross }) => (
      <li>
        <a href={gross} aria-label={`${alt || 'Bild'} groß anzeigen`} data-alt={alt} data-lightbox data-astro-reload>
          <Foto bild={bild} alt={alt} breiten={[300, 600]} sizes="(max-width: 760px) 31vw, 220px" />
        </a>
      </li>
    ))
  }
</ul>

<dialog class="lightbox" aria-label="Bild groß" data-lightbox-dialog>
  <button class="lightbox-zu" type="button" autofocus data-lightbox-zu>Schließen</button>
  <div class="lightbox-ort" data-lightbox-ort></div>
</dialog>

<style>
  .galerie {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(8px, 1.2cqi, 14px);
  }
  .galerie a {
    display: block;
  }
  .galerie :global(.bild) {
    aspect-ratio: 1 / 1;
    border-radius: var(--r-klein);
  }
  .lightbox {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--grund);
    color: var(--text);
  }
  .lightbox::backdrop {
    background: var(--grund);
  }
  .lightbox-ort {
    display: grid;
    place-items: center;
    box-sizing: border-box;
    height: 100%;
    padding: 84px clamp(20px, 4vw, 64px) clamp(20px, 4vw, 64px);
  }
  .lightbox-ort :global(img) {
    display: block;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: var(--r-klein);
  }
  .lightbox-zu {
    position: absolute;
    top: 20px;
    right: clamp(20px, 4vw, 64px);
    height: 44px;
    padding: 0 18px;
    border: 0;
    border-radius: 999px;
    background: var(--flaeche);
    color: var(--text);
    font: 500 15px var(--grotesk);
    cursor: pointer;
  }
</style>

<script>
  function lightboxEinrichten() {
    const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox-dialog]');
    if (!dialog || dialog.dataset.bereit !== undefined) return;
    dialog.dataset.bereit = '';
    const ort = dialog.querySelector('[data-lightbox-ort]');
    if (!ort) return;
    for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-lightbox]')) {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const bild = document.createElement('img');
        bild.src = link.href;
        bild.alt = link.dataset.alt || '';
        ort.replaceChildren(bild);
        dialog.showModal();
      });
    }
    dialog.querySelector('[data-lightbox-zu]')?.addEventListener('click', () => dialog.close());
    // Klick neben das Bild schließt ebenfalls
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || e.target === ort) dialog.close();
    });
  }

  const w = window as Window & { __jbLightbox?: boolean };
  if (!w.__jbLightbox) {
    w.__jbLightbox = true;
    document.addEventListener('astro:page-load', lightboxEinrichten);
  }
  lightboxEinrichten();
</script>
