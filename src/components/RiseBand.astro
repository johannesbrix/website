---
// Rise-and-Shine-Band (invertiert): Motto, Text, eine Zitatkarte und der Klick-Knopf mit Zähler.
// Die Karte zeigt immer ein Zitat; jeder Klick blendet zum nächsten über. Alle Zitate liegen im
// selben Rasterfeld übereinander, deshalb ist die Karte so hoch wie das längste und nichts springt.
// Auf der Startseite als h2, auf /rise-and-shine/ als h1 ganz oben.
import Icon from './Icon.astro';
import { einstellungen, zitate } from '../lib/inhalt';
import { API } from '../lib/dienste';

interface Props {
  ebene?: 'h1' | 'h2';
  /** Ganz oben auf der Seite: ohne Abstand zur Kopfzeile. */
  oben?: boolean;
}

const { ebene = 'h2', oben = false } = Astro.props;
const Titel = ebene;
const site = await einstellungen();
const liste = await zitate();
---

<section class:list={['band', { oben }]} aria-labelledby="rise-titel">
  <div class="rahmen">
    <Titel class="rise-titel" id="rise-titel">{site.motto ?? 'Rise and Shine'}<span class="punkt" aria-hidden="true"></span></Titel>
    {site.motto_text && <p class="rise-text">{site.motto_text}</p>}
    {
      liste.length > 0 && (
        <div class="zitat-karte">
          <Icon name="zitat" class="zitat-zeichen" />
          <div class="zitat-stapel" aria-live="polite">
            {liste.map((zitat, i) => (
              <figure class:list={['zitat', { aktiv: i === 0 }]} data-zitat>
                <blockquote class="zitat-text">„{zitat.text}“</blockquote>
                {zitat.von && <figcaption class="zitat-quelle">{zitat.von}</figcaption>}
              </figure>
            ))}
          </div>
        </div>
      )
    }
    {
      site.klick.knopf && (
        <div class="klick" data-klick data-api={API || undefined}>
          <button class="knopf" type="button" data-klick-knopf>
            {site.klick.knopf}
          </button>
          <p class="zaehler" aria-live="polite">
            <span data-klick-zahl>0</span>×{site.klick.zaehler && ` ${site.klick.zaehler}`}
          </p>
        </div>
      )
    }
  </div>
</section>

<style>
  .band {
    margin-top: clamp(72px, 10cqi, 144px);
    background: var(--text);
    color: var(--grund);
  }
  .band.oben {
    margin-top: 0;
  }
  .band .rahmen {
    padding-block: clamp(56px, 8cqi, 120px);
  }
  .rise-titel {
    font-weight: 700;
    font-size: clamp(58px, 10.5cqi, 168px);
    line-height: 0.92;
    letter-spacing: -0.05em;
  }
  .rise-text {
    margin-top: clamp(20px, 2.4cqi, 32px);
    max-width: 36em;
    font-family: var(--lese);
    font-size: clamp(19px, 1.8cqi, 23px);
    line-height: 1.55;
    opacity: 0.88;
  }

  /* Zitatkarte: immer gefüllt, so hoch wie das längste Zitat */
  .zitat-karte {
    display: grid;
    gap: 14px;
    max-width: 640px;
    margin-top: clamp(28px, 3.6cqi, 44px);
    padding: clamp(20px, 2.8cqi, 32px);
    border-radius: var(--r-gross);
    background: color-mix(in srgb, var(--grund) 8%, transparent);
  }
  .zitat-karte :global(.zitat-zeichen) {
    width: 26px;
    height: 26px;
    color: var(--orange);
  }
  .zitat-stapel {
    display: grid;
  }
  /* Kürzere Zitate stehen mittig, damit der freie Platz nicht nur unten liegt */
  .zitat {
    grid-area: 1 / 1;
    align-self: center;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.35s ease,
      visibility 0s linear 0.35s;
  }
  .zitat.aktiv {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.45s ease 0.1s,
      visibility 0s;
  }
  .zitat-text {
    font-family: var(--lese);
    font-size: clamp(21px, 2.2cqi, 28px);
    line-height: 1.38;
    text-wrap: balance;
  }
  .zitat-quelle {
    margin-top: 10px;
    font-size: 14px;
    font-weight: 500;
    opacity: 0.8; /* bei 0,7 im Dunkelmodus nur 4,25:1 Kontrast */
  }

  .klick {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 24px;
    margin-top: clamp(24px, 3cqi, 36px);
  }
  .knopf {
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    min-height: 58px;
    padding: 14px 28px;
    border: 0;
    border-radius: 29px;
    background: var(--orange);
    color: #ffffff;
    font: 700 19px/1.25 var(--grotesk);
    letter-spacing: -0.01em;
    text-align: left;
    cursor: pointer;
    transition:
      filter 0.15s,
      transform 0.1s;
  }
  .knopf:hover {
    filter: brightness(1.07);
  }
  .knopf:active {
    transform: scale(0.98);
  }
  .zaehler {
    font-size: 17px;
    font-weight: 500;
    opacity: 0.88;
    font-variant-numeric: tabular-nums;
  }
  @media (prefers-reduced-motion: reduce) {
    .zitat,
    .zitat.aktiv {
      transition: none;
    }
  }
</style>

<script>
  // Klick-Zähler: Mit Server (data-api) zählt er alle Klicks aller Besucher. Der Knopf reagiert sofort,
  // die Klicks gehen gebündelt an den Server, der Auto-Klicker begrenzt (api/src/index.js).
  // Ohne Server zählt er nur die Klicks dieses Besuchers (localStorage, mit try/catch).
  // Jeder Klick blendet in der Zitatkarte zum nächsten Zitat über, nach dem letzten wieder von vorn.
  type Zaehler = { api: string; server: number | null; offen: number; unterwegs: boolean; timer: number };
  const SCHLUESSEL = 'klicks';
  const BUENDEL_MS = 700;
  const HOECHSTENS = 10; // Klicks pro Anfrage, so viele nimmt der Server auf einmal an
  const w = window as Window & { __jbKlick?: boolean; __jbKlicks?: number; __jbZaehler?: Zaehler };

  function stand(): number {
    if (w.__jbKlicks === undefined) {
      try {
        w.__jbKlicks = parseInt(localStorage.getItem(SCHLUESSEL) || '0', 10) || 0;
      } catch {
        w.__jbKlicks = 0;
      }
    }
    return w.__jbKlicks;
  }

  function zaehler(api: string): Zaehler {
    if (!w.__jbZaehler || w.__jbZaehler.api !== api) {
      w.__jbZaehler = { api, server: null, offen: 0, unterwegs: false, timer: 0 };
    }
    return w.__jbZaehler;
  }

  // Zeigt die Zahl in allen Zählern der aktuellen Seite
  function anzeigen() {
    const z = w.__jbZaehler;
    const wert = z && z.api && z.server !== null ? z.server + z.offen : stand();
    document.querySelectorAll('[data-klick-zahl]').forEach((el) => (el.textContent = wert.toLocaleString('de-DE')));
  }

  async function laden(z: Zaehler) {
    try {
      const antwort = await fetch(`${z.api}/klicks`);
      if (antwort.ok) z.server = (await antwort.json()).wert;
    } catch {}
    anzeigen();
  }

  async function senden(z: Zaehler) {
    z.timer = 0;
    if (z.unterwegs || z.offen === 0) return;
    const anzahl = Math.min(z.offen, HOECHSTENS);
    z.unterwegs = true;
    try {
      const antwort = await fetch(`${z.api}/klicks`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ anzahl }),
      });
      if (antwort.ok) z.server = (await antwort.json()).wert;
    } catch {}
    z.offen -= anzahl; // auch was der Server nicht gezählt hat, fällt weg
    z.unterwegs = false;
    anzeigen();
    if (z.offen > 0) planen(z);
  }

  function planen(z: Zaehler) {
    if (!z.timer) z.timer = window.setTimeout(() => senden(z), BUENDEL_MS);
  }

  function naechstesZitat(band: Element | null) {
    const alle = band ? [...band.querySelectorAll('[data-zitat]')] : [];
    if (alle.length < 2) return;
    const jetzt = Math.max(0, alle.findIndex((el) => el.classList.contains('aktiv')));
    alle[jetzt].classList.remove('aktiv');
    alle[(jetzt + 1) % alle.length].classList.add('aktiv');
  }

  function klickEinrichten() {
    for (const box of document.querySelectorAll<HTMLElement>('[data-klick]')) {
      if (box.dataset.bereit !== undefined) continue;
      box.dataset.bereit = '';
      const knopf = box.querySelector('[data-klick-knopf]');
      if (!knopf) continue;
      const api = box.dataset.api || '';
      const z = api ? zaehler(api) : null;
      anzeigen();
      if (z) laden(z);
      knopf.addEventListener('click', () => {
        w.__jbKlicks = stand() + 1;
        try {
          localStorage.setItem(SCHLUESSEL, String(w.__jbKlicks));
        } catch {}
        if (z) {
          z.offen++;
          planen(z);
        }
        anzeigen();
        naechstesZitat(box.closest('.band'));
      });
    }
  }

  if (!w.__jbKlick) {
    w.__jbKlick = true;
    document.addEventListener('astro:page-load', klickEinrichten);
    // Wer die Seite direkt nach dem Klicken schließt: offene Klicks noch losschicken
    window.addEventListener('pagehide', () => {
      const z = w.__jbZaehler;
      if (z && z.api && z.offen > 0 && navigator.sendBeacon) {
        navigator.sendBeacon(`${z.api}/klicks`, JSON.stringify({ anzahl: Math.min(z.offen, HOECHSTENS) }));
        z.offen = 0;
      }
    });
  }
  klickEinrichten();
</script>
