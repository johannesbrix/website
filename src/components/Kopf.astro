---
// Kopfzeile: „JB.“ links, rechts die drei Türen. Unter 760 px ein runder Icon-Knopf, der ein
// Vollbild-Menü öffnet (modaler <dialog>: Escape schließt, der Rest der Seite ist inert).
// Das Menü ist bewusst typografisch: die drei Türen groß wie Seitentitel, die aktuelle Seite trägt
// den orangen Punkt wie „JB.“; unten nur die Plattformen und Rechtliches.
import Icon from './Icon.astro';
import { bereiche, einstellungen, plattformen } from '../lib/inhalt';

const site = await einstellungen();
const pfad = Astro.url.pathname;

// Drei Türen: was ich mache, was mich antreibt, wo wir uns begegnen
const eintraege: { name: string; href: string }[] = [
  { name: 'Projekte', href: '/projekte/' },
  { name: 'Rise & Shine', href: '/rise-and-shine/' },
  { name: 'Brixmap', href: '/brixmap/' },
];
// Bereichsseiten und Beiträge gehören zu „Projekte“
const projektPfade = (await bereiche()).map((b) => `/${b.id}/`);

// aria-current: „page“ auf der Seite selbst, „true“ auf Unterseiten
function aktuell(href: string) {
  if (pfad === href || pfad === href.slice(0, -1)) return 'page';
  if (pfad.startsWith(href)) return 'true';
  if (href === '/projekte/' && projektPfade.some((p) => pfad.startsWith(p) || pfad === p.slice(0, -1))) return 'true';
  return undefined;
}
const links = plattformen(site.links);
---

<header class="kopf rahmen">
  <a class="logo" href="/">JB<span class="punkt" aria-hidden="true"></span><span class="nur-sr">, {site.name}, zur Startseite</span></a>
  <nav class="nav" aria-label="Hauptnavigation">
    {eintraege.map((e) => <a href={e.href} aria-current={aktuell(e.href)}>{e.name}</a>)}
  </nav>
  <button class="icon-knopf menue-auf" type="button" aria-label="Menü" aria-expanded="false" aria-controls="menue" data-menue-auf>
    <span class="menue-linien" aria-hidden="true"><span></span><span></span></span>
  </button>
</header>

<dialog class="menue-panel" id="menue" aria-label="Menü" tabindex="-1" data-menue>
  <div class="kopf menue-kopf">
    <a class="logo" href="/">JB<span class="punkt" aria-hidden="true"></span><span class="nur-sr">, {site.name}, zur Startseite</span></a>
    <button class="icon-knopf" type="button" aria-label="Menü schließen" data-menue-zu>
      <Icon name="schliessen" />
    </button>
  </div>
  <nav class="menue-nav" aria-label="Hauptnavigation">
    <ul class="liste">
      {
        eintraege.map((e, i) => (
          <li style={`--i: ${i}`}>
            <a href={e.href} aria-current={aktuell(e.href)}>
              {e.name}
              <span class="punkt" aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="menue-unten">
    {
      links.length > 0 && (
        <ul class="sozial">
          {links.map((l) => (
            <li>
              <a class="icon-knopf" href={l.href} rel="me" aria-label={l.name} title={l.name}>
                <Icon name={l.icon} />
              </a>
            </li>
          ))}
        </ul>
      )
    }
    <p class="menue-klein"><a href="/impressum/">Impressum</a><a href="/datenschutz/">Datenschutz</a></p>
  </div>
</dialog>

<style>
  .kopf {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 84px;
  }
  .logo {
    display: inline-flex;
    align-items: baseline;
    font-weight: 700;
    font-size: 27px;
    letter-spacing: -0.045em;
    text-decoration: none;
  }
  .nav {
    display: flex;
    gap: 30px;
  }
  .nav a {
    padding-block: 10px;
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
  }
  .nav a:hover,
  .nav a[aria-current] {
    text-decoration: underline;
    text-decoration-color: var(--orange);
    text-decoration-thickness: 2px;
    text-underline-offset: 7px;
  }
  .menue-auf {
    display: none;
  }
  /* Zwei Linien statt drei: ruhiger, gleiche Breite wie das Schließen-Kreuz */
  .menue-linien {
    display: grid;
    gap: 6px;
    width: 18px;
  }
  .menue-linien span {
    height: 2px;
    border-radius: 2px;
    background: currentColor;
  }
  @container (max-width: 760px) {
    .kopf {
      min-height: 68px;
    }
    .nav {
      display: none;
    }
    .menue-auf {
      display: inline-grid;
    }
  }

  /* Vollbild-Menü. Kein .rahmen hier: dessen margin-inline: auto ließe die Zeilen im
     Flex-Layout auf Inhaltsbreite schrumpfen und in die Mitte rutschen. */
  .menue-panel {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0 clamp(20px, 4.4cqi, 64px);
    box-sizing: border-box;
    border: 0;
    overflow-y: auto;
    background: var(--grund);
    color: var(--text);
  }
  .menue-panel[open] {
    display: flex;
    flex-direction: column;
    animation: menue-auf 0.2s ease-out;
  }
  .menue-panel:focus {
    outline: none;
  }
  .menue-panel::backdrop {
    background: var(--grund);
  }
  @keyframes menue-auf {
    from {
      opacity: 0;
    }
  }
  .menue-kopf {
    min-height: 68px;
  }

  /* Die drei Türen: groß wie Seitentitel, feine Linien dazwischen, die aktuelle Seite mit Punkt */
  .menue-nav {
    padding-top: clamp(16px, 5vh, 48px);
  }
  .menue-nav li {
    border-bottom: 1px solid var(--linie);
    opacity: 0;
    transform: translateY(10px);
    animation: menue-ein 0.45s cubic-bezier(0.2, 0.75, 0.25, 1) forwards;
    animation-delay: calc(var(--i) * 50ms + 60ms);
  }
  .menue-nav li:first-child {
    border-top: 1px solid var(--linie);
  }
  @keyframes menue-ein {
    to {
      opacity: 1;
      transform: none;
    }
  }
  .menue-nav a {
    display: flex;
    align-items: baseline;
    padding-block: 20px;
    font-weight: 700;
    font-size: clamp(38px, 11vw, 52px);
    letter-spacing: -0.045em;
    line-height: 1;
    text-decoration: none;
  }
  .menue-nav .punkt {
    opacity: 0;
    transition: opacity 0.15s;
  }
  .menue-nav a[aria-current] .punkt {
    opacity: 1;
  }
  .menue-nav a:active {
    opacity: 0.6;
  }
  .menue-unten {
    display: grid;
    gap: 20px;
    margin-top: auto;
    padding-top: 32px;
    padding-bottom: max(28px, env(safe-area-inset-bottom));
  }
  .menue-klein {
    display: flex;
    gap: 20px;
    font-size: 14px;
    color: var(--leise);
  }
  .menue-klein a {
    display: inline-block;
    padding-block: 12px;
    margin-block: -12px;
    text-decoration: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .menue-panel[open] {
      animation: none;
    }
    .menue-nav li {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  // Hängt sich an astro:page-load, weil die Kopfzeile bei jedem Seitenwechsel neu kommt.
  // Doppeltes Anbinden verhindern data-bereit und das Fenster-Flag.
  function menueEinrichten() {
    const auf = document.querySelector<HTMLButtonElement>('[data-menue-auf]');
    const menue = document.querySelector<HTMLDialogElement>('[data-menue]');
    if (!auf || !menue || auf.dataset.bereit !== undefined) return;
    auf.dataset.bereit = '';
    auf.addEventListener('click', () => {
      menue.showModal();
      // Fokus aufs Menü selbst statt auf den ersten Knopf: kein Fokusring beim Öffnen mit dem Finger,
      // mit der Tastatur führt Tab direkt zu den Einträgen
      menue.focus();
      auf.setAttribute('aria-expanded', 'true');
    });
    menue.addEventListener('close', () => auf.setAttribute('aria-expanded', 'false'));
    menue.querySelector('[data-menue-zu]')?.addEventListener('click', () => menue.close());
  }

  const w = window as Window & { __jbMenue?: boolean };
  if (!w.__jbMenue) {
    w.__jbMenue = true;
    document.addEventListener('astro:page-load', menueEinrichten);
    // Wird das Fenster breiter als das Handy-Layout, schließt das Menü.
    window.matchMedia('(min-width: 761px)').addEventListener('change', (e) => {
      if (e.matches) document.querySelector<HTMLDialogElement>('[data-menue][open]')?.close();
    });
  }
  menueEinrichten();
</script>
