</style>

<script>
  import L from 'leaflet';
  import { ARTEN, KATEGORIEN, type Art, type Kategorie, type Ort } from '../lib/brixmap';

  type Zustand = {
    karte: L.Map;
    buehne: HTMLElement;
    ortkarte: HTMLElement;
    ebenen: Record<Art, L.LayerGroup>;
    marker: Map<string, L.Marker>;
    orte: Ort[];
    filter: Art | 'alle';
    api: string;
    gewaehlt: string | null;
    hervor: string | null;
    zurueck: HTMLElement | null;
    vorschlag: string;
    geoeffnet: number;
    beruehrt: boolean;
    /** Geräte-Schlüssel, nur auf Johannes' freigeschaltetem Gerät (sonst leer) */
    ich: string;
  };

  const KACHELN = 'https://tile.openstreetmap.de/{z}/{x}/{y}.png';
  const NAMENSNENNUNG = '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap-Mitwirkende</a>';
  const START: L.LatLngTuple = [51.16, 10.45]; // Mitte Deutschlands, wenn es noch keine Orte gibt
  const WAHL_TEXT = 'Schieb die Karte, bis der Pin auf dem Ort sitzt.';
  // Reihenfolge in der Liste und Stapelung auf der Karte: Johannes' Orte oben
  const RANG: Record<Art, number> = { ich: 0, empfehlung: 1 };
  const EBENE: Record<Art, number> = { ich: 400, empfehlung: 0 };
  const GERAET = 'jb-ich'; // localStorage: Geräte-Schlüssel von Johannes

  let aktiv: Zustand | null = null;
  let toastZeit = 0;
  const bewegungArm = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const geteilt = (z: Zustand) => getComputedStyle(z.buehne).getPropertyValue('--geteilt').trim() === '1';

  // Pins und Icons kommen aus <template>-Vorlagen im HTML
  const vorlage = (name: string) => document.querySelector<HTMLTemplateElement>(`template[data-vorlage="${name}"]`);
  const vorlageHtml = (name: string) => vorlage(name)?.innerHTML.trim() ?? '';
  const vorlageKnoten = (name: string) =>
    (vorlage(name)?.content.firstElementChild?.cloneNode(true) as Element | undefined) ?? document.createElement('span');

  function span(klasse: string, text: string) {
    const s = document.createElement('span');
    s.className = klasse;
    s.textContent = text;
    return s;
  }

  function artText(ort: Ort) {
    if (ort.art === 'ich') return 'Von mir';
    return ort.von ? `Empfohlen von ${ort.von}` : 'Empfohlen';
  }

  // Listeneintrag wie im HTML, ausschließlich über textContent (Empfehlungen sind Text von Besuchern)
  function listenEintrag(ort: Ort) {
    const li = document.createElement('li');
    li.dataset.art = ort.art;
    const knopf = document.createElement('button');
    knopf.type = 'button';
    knopf.className = 'ort';
    knopf.dataset.zeige = ort.id;
    const meta = span('ort-meta', '');
    meta.append(span('', ARTEN[ort.art].name));
    if (ort.kategorie) meta.append(span('', KATEGORIEN[ort.kategorie]));
    if (ort.von) meta.append(span('', `von ${ort.von}`));
    const text = span('ort-text', '');
    text.append(span('ort-name', ort.name), meta);
    if (ort.notiz) text.append(span('ort-notiz', ort.notiz));
    knopf.append(vorlageKnoten(`pin-${ort.art}`), text);
    if (ort.id === aktiv?.gewaehlt) knopf.setAttribute('aria-current', 'true');
    li.append(knopf);
    return li;
  }

  function listeZeichnen(z: Zustand) {
    const sortiert = [...z.orte].sort((a, b) => RANG[a.art] - RANG[b.art]);
    document.querySelector('[data-ortsliste]')?.replaceChildren(...sortiert.map(listenEintrag));
  }

  const markerIcon = (art: Art) =>
    L.divIcon({ className: 'marker', html: vorlageHtml(`pin-${art}`), iconSize: [44, 44], iconAnchor: [22, 22] });

  function hinzufuegen(z: Zustand, orte: Ort[], vorne = false) {
    for (const ort of orte) {
      if (!Number.isFinite(ort.lat) || !Number.isFinite(ort.lng) || z.marker.has(ort.id)) continue;
      const id = ort.id;
      const marker = L.marker([ort.lat, ort.lng], { icon: markerIcon(ort.art), zIndexOffset: EBENE[ort.art], riseOnHover: true });
      marker.on('add', () => {
        const element = marker.getElement();
        const aktuell = z.orte.find((o) => o.id === id);
        if (!element || !aktuell) return;
        // Name für Screenreader, sicher per setAttribute (Empfehlungen sind Text von Besuchern)
        element.setAttribute('aria-label', `${artText(aktuell)}: ${aktuell.name}`);
        element.setAttribute('role', 'button');
        element.classList.toggle('aktiv', z.gewaehlt === id);
      });
      marker.on('click', () => auswaehlen(z, id));
      // Erst merken, dann auf die Karte: Ist die Ebene schon sichtbar, feuert 'add' sofort und braucht den Ort
      if (vorne) z.orte.unshift(ort);
      else z.orte.push(ort);
      z.marker.set(id, marker);
      marker.addTo(z.ebenen[ort.art]);
    }
    listeZeichnen(z);
    filtern(z, z.filter);
  }

  function filtern(z: Zustand, filter: Art | 'alle') {
    z.filter = filter;
    (Object.keys(z.ebenen) as Art[]).forEach((art) => {
      if (filter === 'alle' || filter === art) z.ebenen[art].addTo(z.karte);
      else z.ebenen[art].remove();
    });
    document.querySelectorAll<HTMLElement>('[data-filter]').forEach((k) => k.setAttribute('aria-pressed', String(k.dataset.filter === filter)));
    let sichtbar = 0;
    document.querySelectorAll<HTMLLIElement>('[data-ortsliste] li').forEach((li) => {
      li.hidden = filter !== 'alle' && li.dataset.art !== filter;
      if (!li.hidden) sichtbar++;
    });
    const anzahl = document.querySelector('[data-anzahl]');
    if (anzahl) anzahl.textContent = String(sichtbar);
    const leer = document.querySelector<HTMLElement>('[data-leer]');
    if (leer) leer.hidden = sichtbar > 0;
    const gewaehlt = z.orte.find((o) => o.id === z.gewaehlt);
    if (gewaehlt && filter !== 'alle' && filter !== gewaehlt.art) schliessen(z, false);
  }

  // Ortskarte füllen, ausschließlich über textContent
  function kartenInhalt(z: Zustand, ort: Ort) {
    const feld = <T extends HTMLElement = HTMLElement>(name: string) => z.ortkarte.querySelector<T>(`[data-k="${name}"]`)!;
    feld('pin').replaceChildren(vorlageKnoten(`pin-${ort.art}`));
    feld('art').textContent = artText(ort);
    feld('name').textContent = ort.name;
    const kategorie = feld('kategorie');
    kategorie.hidden = !ort.kategorie;
    if (ort.kategorie) kategorie.replaceChildren(vorlageKnoten(`kategorie-${ort.kategorie}`), KATEGORIEN[ort.kategorie]);
    const notiz = feld('notiz');
    notiz.hidden = !ort.notiz;
    notiz.textContent = ort.notiz ?? '';
    feld<HTMLAnchorElement>('route').href = `https://www.google.com/maps/dir/?api=1&destination=${ort.lat},${ort.lng}`;
    const link = feld<HTMLAnchorElement>('link');
    link.hidden = !ort.link;
    if (ort.link) {
      link.href = ort.link;
      link.classList.toggle('nach-aussen', !ort.link.startsWith('/'));
      feld('linktext').textContent = ort.linkText || 'Mehr dazu';
    }
    // Verwalten nur auf Johannes' Gerät und nur für Orte vom Server (nicht für Orte aus Beiträgen)
    const verwalten = z.ortkarte.querySelector<HTMLElement>('[data-k="verwalten"]');
    if (verwalten) {
      verwalten.hidden = !z.ich || !ort.id.startsWith('e-');
      feld('loeschen').classList.remove('sicher');
      feld('loeschen-text').textContent = 'Löschen';
    }
    // Lange Texte kürzen; „Mehr anzeigen“ nur, wenn wirklich etwas abgeschnitten ist
    z.ortkarte.classList.remove('ganz');
    feld('mehr').hidden = true;
  }

  function mehrPruefen(z: Zustand) {
    const gekuerzt = [...z.ortkarte.querySelectorAll<HTMLElement>('.kurz')].some((e) => !e.hidden && e.scrollHeight > e.clientHeight + 1);
    z.ortkarte.querySelector<HTMLElement>('[data-k="mehr"]')!.hidden = !gekuerzt;
  }

  // Pin so verschieben, dass er nicht unter der Ortskarte oder den Knöpfen liegt.
  // immer = true (aus der Liste, über ?ort=): in die Mitte der freien Fläche und näher heran.
  function insBild(z: Zustand, ort: L.LatLng, immer: boolean) {
    const { karte, buehne, ortkarte } = z;
    const groesse = karte.getSize();
    const oben = 72;
    let unten = groesse.y - 96;
    const p = karte.latLngToContainerPoint(ort);
    let verdeckt = false;
    if (!ortkarte.hidden) {
      const b = buehne.getBoundingClientRect();
      const r = ortkarte.getBoundingClientRect();
      unten = r.top - b.top - 16;
      verdeckt = p.x > r.left - b.left - 24 && p.x < r.right - b.left + 24 && p.y > r.top - b.top - 24;
    }
    const zoom = immer ? Math.max(karte.getZoom(), 15) : karte.getZoom();
    if (!immer && !verdeckt && p.x > 24 && p.x < groesse.x - 24 && p.y > oben && p.y < groesse.y - 24) return;
    const mitte = (oben + Math.max(unten, oben + 40)) / 2;
    const punkt = karte.project(ort, zoom).add([0, groesse.y / 2 - mitte]);
    karte.setView(karte.unproject(punkt, zoom), zoom, { animate: !bewegungArm() });
  }

  function markieren(z: Zustand, id: string | null, an: boolean) {
    const ort = z.orte.find((o) => o.id === id);
    const marker = id ? z.marker.get(id) : undefined;
    if (!ort || !marker) return;
    marker.getElement()?.classList.toggle('aktiv', an);
    marker.setZIndexOffset(an ? 1000 : EBENE[ort.art]);
    const knopf = document.querySelector(`[data-zeige="${CSS.escape(ort.id)}"]`);
    if (an) knopf?.setAttribute('aria-current', 'true');
    else knopf?.removeAttribute('aria-current');
  }

  function adresse(id: string | null) {
    const url = new URL(location.href);
    if (id) url.searchParams.set('ort', id);
    else url.searchParams.delete('ort');
    url.searchParams.delete('empfehlen');
    history.replaceState(history.state, '', url);
  }

  function auswaehlen(z: Zustand, id: string, immer = false) {
    const ort = z.orte.find((o) => o.id === id);
    const marker = z.marker.get(id);
    if (!ort || !marker) return;
    if (z.filter !== 'alle' && z.filter !== ort.art) filtern(z, 'alle');
    if (z.gewaehlt !== id) markieren(z, z.gewaehlt, false);
    if (z.ortkarte.hidden) z.zurueck = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    z.gewaehlt = id;
    markieren(z, id, true);
    kartenInhalt(z, ort);
    z.ortkarte.hidden = false;
    z.buehne.classList.add('mit-karte');
    mehrPruefen(z);
    insBild(z, marker.getLatLng(), immer);
    z.ortkarte.focus({ preventScroll: true });
    if (geteilt(z)) document.querySelector(`[data-zeige="${CSS.escape(id)}"]`)?.scrollIntoView({ block: 'nearest' });
    adresse(id);
  }

  function schliessen(z: Zustand, fokus = true) {
    if (!z.gewaehlt) return;
    markieren(z, z.gewaehlt, false);
    z.gewaehlt = null;
    z.ortkarte.hidden = true;
    z.buehne.classList.remove('mit-karte');
    if (fokus && z.zurueck?.isConnected) z.zurueck.focus({ preventScroll: true });
    z.zurueck = null;
    adresse(null);
  }

  function hervorheben(z: Zustand, id: string | null) {
    if (z.hervor === id) return;
    if (z.hervor) z.marker.get(z.hervor)?.getElement()?.classList.remove('hervor');
    z.hervor = id;
    if (id) z.marker.get(id)?.getElement()?.classList.add('hervor');
  }

  function einpassen(z: Zustand) {
    const sichtbar = z.orte.filter((o) => z.filter === 'alle' || z.filter === o.art);
    if (sichtbar.length === 0) return z.karte.setView(START, 6);
    const grenzen = L.latLngBounds(sichtbar.map((o) => [o.lat, o.lng] as L.LatLngTuple));
    z.karte.fitBounds(grenzen, { paddingTopLeft: [32, 80], paddingBottomRight: [32, 96], maxZoom: 14 });
  }

  // Die Texte über der Karte haben krumme Höhen, dann beginnt die Karte z. B. bei 259,06 px. Kacheln an
  // solchen Kanten werden geglättet und zeigen Haarlinien. Deshalb die Karte um den Rest bis zum
  // nächsten ganzen Gerätepixel verschieben (höchstens einen Pixel, nicht zu sehen).
  function aufGeraetepixel(element: HTMLElement) {
    element.style.top = element.style.left = '';
    const r = element.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;
    const rest = (wert: number) => (Math.ceil(wert * dpr - 0.001) - wert * dpr) / dpr;
    element.style.top = `${rest(r.top + window.scrollY)}px`;
    element.style.left = `${rest(r.left + window.scrollX)}px`;
  }

  function sichtbarMachen(element: HTMLElement) {
    const r = element.getBoundingClientRect();
    if (r.top >= 0 && r.bottom <= window.innerHeight) return;
    element.scrollIntoView({ behavior: bewegungArm() ? 'auto' : 'smooth', block: r.height > window.innerHeight ? 'start' : 'center' });
  }

  function toast(text: string) {
    const element = document.querySelector<HTMLElement>('[data-toast]');
    if (!element) return;
    element.textContent = text;
    element.classList.add('zeigen');
    window.clearTimeout(toastZeit);
    toastZeit = window.setTimeout(() => element.classList.remove('zeigen'), 4500);
  }

  // Ort vom Server in einen Ort für Karte und Liste übersetzen
  function ausServer(o: Record<string, unknown>): Ort {
    const kategorie = String(o.kategorie) as Kategorie;
    return {
      id: `e-${o.id}`,
      art: o.status === 'ich' ? 'ich' : 'empfehlung',
      name: String(o.name ?? ''),
      kategorie: kategorie in KATEGORIEN ? kategorie : undefined,
      notiz: o.notiz ? String(o.notiz) : undefined,
      lat: Number(o.lat),
      lng: Number(o.lng),
      von: o.von ? String(o.von) : undefined,
    };
  }

  // ---------- Verwalten auf Johannes' Gerät ----------

  function ortEntfernen(z: Zustand, id: string) {
    const ort = z.orte.find((o) => o.id === id);
    const marker = z.marker.get(id);
    if (z.gewaehlt === id) schliessen(z, false);
    if (ort && marker) z.ebenen[ort.art].removeLayer(marker);
    z.marker.delete(id);
    z.orte = z.orte.filter((o) => o.id !== id);
    listeZeichnen(z);
    filtern(z, z.filter);
  }

  async function loeschen(z: Zustand, id: string) {
    try {
      const antwort = await fetch(`${z.api}/orte/aendern`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ ich: z.ich, id: Number(id.slice(2)), aktion: 'loeschen' }),
      });
      const ergebnis = (await antwort.json().catch(() => ({}))) as { fehler?: string };
      if (antwort.status === 401) {
        geraetVergessen(z);
        return toast('Die Freischaltung gilt nicht mehr. Bitte im Admin neu freischalten.');
      }
      if (!antwort.ok) return toast(ergebnis.fehler || 'Das hat nicht geklappt.');
      ortEntfernen(z, id);
      toast('Gelöscht.');
    } catch {
      toast('Keine Verbindung. Bitte später nochmal.');
    }
  }

  // Knopf, Pin in der Kartenmitte und Formular zeigen, ob von hier eigene Orte gesetzt werden
  function geraetAnzeigen(z: Zustand) {
    const ich = Boolean(z.ich);
    document.querySelector('[data-nadel]')?.replaceChildren(vorlageKnoten(ich ? 'pin-ich' : 'pin-empfehlung'));
    document.querySelectorAll<HTMLElement>('[data-nur-besucher]').forEach((e) => {
      e.hidden = ich;
      e.querySelectorAll<HTMLInputElement>('input').forEach((feld) => (feld.disabled = ich));
    });
    const notiz = document.querySelector<HTMLTextAreaElement>('[data-formular] [name="notiz"]');
    if (notiz) notiz.required = !ich;
    const notizName = document.querySelector('[data-notiz-name]');
    if (notizName) notizName.textContent = ich ? 'Notiz (optional)' : 'Warum empfiehlst du ihn?';
    const titel = document.querySelector('[data-sheet-titel]');
    if (titel) titel.textContent = ich ? 'Eigenen Ort setzen' : 'Ort empfehlen';
    document.querySelectorAll('[data-empfehlen-text]').forEach((e) => (e.textContent = ich ? 'Ort setzen' : 'Empfehlen'));
  }

  function geraetVergessen(z: Zustand) {
    z.ich = '';
    try {
      localStorage.removeItem(GERAET);
    } catch {}
    geraetAnzeigen(z);
    if (z.gewaehlt) auswaehlen(z, z.gewaehlt);
  }

  // Freischaltung aus dem Admin kommt als #ich=… in der Adresse: speichern und sofort aus der Adresse nehmen
  function geraetLesen(): { schluessel: string; neu: boolean } {
    const treffer = location.hash.match(/^#ich=([\w.]+)$/);
    if (treffer) {
      try {
        localStorage.setItem(GERAET, treffer[1]);
      } catch {}
      history.replaceState(history.state, '', location.pathname + location.search);
      return { schluessel: treffer[1], neu: true };
    }
    try {
      return { schluessel: localStorage.getItem(GERAET) || '', neu: false };
    } catch {
      return { schluessel: '', neu: false };
    }
  }

  async function empfehlungenLaden(z: Zustand) {
    try {
      const antwort = await fetch(`${z.api}/orte`);
      if (!antwort.ok) return;
      const { orte } = (await antwort.json()) as { orte: Record<string, unknown>[] };
      hinzufuegen(z, orte.map(ausServer));
    } catch {}
  }

  // ---------- Ort wählen ----------

  const wahlText = (text: string) => {
    const element = document.querySelector('[data-wahl-text]');
    if (element) element.textContent = text;
  };

  function waehlenStarten(z: Zustand) {
    schliessen(z, false);
    z.vorschlag = '';
    wahlText(WAHL_TEXT);
    z.buehne.classList.add('waehlt');
    sichtbarMachen(z.buehne);
    // Am Handy nicht gleich die Tastatur öffnen
    const fein = window.matchMedia('(pointer: fine)').matches;
    document.querySelector<HTMLElement>(fein ? '#ortssuche' : '[data-hier]')?.focus({ preventScroll: true });
  }

  function waehlenBeenden(z: Zustand) {
    z.buehne.classList.remove('waehlt', 'bewegt');
    const treffer = document.querySelector<HTMLElement>('[data-treffer]');
    treffer?.replaceChildren();
    if (treffer) treffer.hidden = true;
    const suche = document.querySelector<HTMLInputElement>('#ortssuche');
    if (suche) suche.value = '';
    document.querySelector<HTMLElement>('.unten [data-empfehlen]')?.focus({ preventScroll: true });
  }

  function hierIstEs(z: Zustand) {
    // Zu weit weg, um einen Ort genau zu treffen: erst heranzoomen
    if (z.karte.getZoom() < 15) {
      z.karte.setView(z.karte.getCenter(), 17, { animate: !bewegungArm() });
      wahlText('Näher dran. Sitzt der Pin genau?');
      return;
    }
    const dialog = document.querySelector<HTMLDialogElement>('[data-dialog]');
    if (!dialog) return;
    const name = document.querySelector<HTMLInputElement>('[data-formular] [name="name"]');
    if (name && !name.value && z.vorschlag) name.value = z.vorschlag;
    document.querySelector<HTMLElement>('[data-fehler]')!.hidden = true;
    z.geoeffnet = performance.now();
    dialog.showModal();
    if (window.matchMedia('(pointer: fine)').matches) name?.focus();
  }

  function trefferHinweis(text: string) {
    const li = document.createElement('li');
    li.append(span('treffer-hinweis', text));
    return li;
  }

  async function suchen(z: Zustand, begriff: string) {
    const ziel = document.querySelector<HTMLElement>('[data-treffer]');
    if (!ziel || begriff.trim().length < 2) return;
    ziel.hidden = false;
    ziel.replaceChildren(trefferHinweis('Suche …'));
    try {
      const antwort = await fetch(`${z.api}/suche?q=${encodeURIComponent(begriff.trim())}`);
      const daten = (await antwort.json()) as { treffer?: { name: string; adresse: string; lat: number; lng: number }[]; fehler?: string };
      const treffer = daten.treffer ?? [];
      if (treffer.length === 0) {
        ziel.replaceChildren(trefferHinweis(daten.fehler ?? 'Nichts gefunden. Schieb die Karte einfach selbst hin.'));
        return;
      }
      ziel.replaceChildren(
        ...treffer.map((t) => {
          const li = document.createElement('li');
          const knopf = document.createElement('button');
          knopf.type = 'button';
          knopf.append(span('treffer-name', t.name), span('treffer-adresse', t.adresse));
          knopf.addEventListener('click', () => {
            z.karte.setView([t.lat, t.lng], 17, { animate: !bewegungArm() });
            z.vorschlag = t.name;
            ziel.hidden = true;
            ziel.replaceChildren();
            document.querySelector<HTMLElement>('[data-hier]')?.focus({ preventScroll: true });
            wahlText(WAHL_TEXT);
          });
          li.append(knopf);
          return li;
        }),
      );
    } catch {
      ziel.replaceChildren(trefferHinweis('Die Suche klappt gerade nicht. Schieb die Karte einfach selbst hin.'));
    }
  }

  async function senden(z: Zustand, formular: HTMLFormElement) {
    const fehler = document.querySelector<HTMLElement>('[data-fehler]')!;
    const knopf = document.querySelector<HTMLButtonElement>('[data-senden]')!;
    if (!formular.reportValidity()) return;
    const daten = new FormData(formular);
    const { lat, lng } = z.karte.getCenter();
    knopf.disabled = true;
    fehler.hidden = true;
    try {
      const antwort = await fetch(`${z.api}/orte`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          name: daten.get('name'),
          kategorie: daten.get('kategorie'),
          notiz: daten.get('notiz'),
          von: daten.get('von'),
          website: daten.get('website'),
          einwilligung: daten.get('einwilligung') === 'on',
          lat,
          lng,
          dauer: Math.round(performance.now() - z.geoeffnet),
          ...(z.ich && { ich: z.ich }),
        }),
      });
      const ergebnis = (await antwort.json().catch(() => ({}))) as { fehler?: string; ort?: Record<string, unknown>; sichtbar?: boolean };
      if (antwort.status === 401 && z.ich) {
        geraetVergessen(z);
        fehler.textContent = 'Die Freischaltung gilt nicht mehr. Bitte im Admin neu freischalten oder als Empfehlung senden.';
        fehler.hidden = false;
      } else if (antwort.ok) {
        formular.reset();
        document.querySelector<HTMLDialogElement>('[data-dialog]')?.close();
        waehlenBeenden(z);
        if (ergebnis.ort) {
          const ort = ausServer(ergebnis.ort);
          hinzufuegen(z, [ort], true);
          auswaehlen(z, ort.id, true);
          toast(ort.art === 'ich' ? 'Dein Ort ist jetzt auf der Karte.' : 'Danke! Dein Ort ist jetzt auf der Karte.');
        } else {
          toast(ergebnis.sichtbar === false ? 'Danke! Dein Ort erscheint, sobald er freigegeben ist.' : 'Danke für deine Empfehlung!');
        }
      } else {
        fehler.textContent = ergebnis.fehler || 'Das hat leider nicht geklappt. Bitte versuch es später nochmal.';
        fehler.hidden = false;
      }
    } catch {
      fehler.textContent = 'Keine Verbindung. Bitte versuch es später nochmal.';
      fehler.hidden = false;
    }
    knopf.disabled = false;
  }

  // ---------- Einrichten ----------

  function einrichten() {
    const element = document.querySelector<HTMLElement>('[data-karte]');
    if (!element || element.dataset.bereit !== undefined) return;
    element.dataset.bereit = '';
    const buehne = element.closest<HTMLElement>('[data-buehne]')!;
    aufGeraetepixel(element);
    // Ganze Zoomstufen: Kartenbilder in Originalgröße, scharf und ohne Hochskalieren
    const karte = L.map(element, { attributionControl: false, zoomControl: false, scrollWheelZoom: false, maxZoom: 18 });
    L.control.attribution({ position: 'bottomright', prefix: false }).addTo(karte);
    L.control.zoom({ position: 'bottomright', zoomInTitle: 'Hineinzoomen', zoomOutTitle: 'Herauszoomen' }).addTo(karte);
    // Kacheln erst laden, wenn der Ausschnitt mit allen Orten feststeht (sonst lädt erst ganz Deutschland)
    const kacheln = L.tileLayer(KACHELN, { maxZoom: 18, attribution: NAMENSNENNUNG });
    const kachelnLaden = () => karte.hasLayer(kacheln) || kacheln.addTo(karte);

    const z: Zustand = {
      karte,
      buehne,
      ortkarte: buehne.querySelector<HTMLElement>('[data-ortkarte]')!,
      ebenen: { ich: L.layerGroup(), empfehlung: L.layerGroup() },
      marker: new Map(),
      orte: [],
      filter: 'alle',
      api: element.dataset.api || '',
      gewaehlt: null,
      hervor: null,
      zurueck: null,
      vorschlag: '',
      geoeffnet: 0,
      beruehrt: false,
      ich: '',
    };
    aktiv = z;
    const geraet = element.dataset.api ? geraetLesen() : { schluessel: '', neu: false };
    z.ich = geraet.schluessel;
    geraetAnzeigen(z);
    if (geraet.neu) toast('Freigeschaltet: Orte, die du hier setzt, erscheinen als deine.');

    // Mausrad: in der geteilten Ansicht (Karte so hoch wie das Fenster) zoomt es direkt,
    // sonst erst nach einem Klick in die Karte, damit die Seite weiter scrollt
    const mausrad = () => (geteilt(z) ? karte.scrollWheelZoom.enable() : karte.scrollWheelZoom.disable());
    mausrad();
    karte.on('resize', () => {
      mausrad();
      aufGeraetepixel(element);
    });
    // Nach dem Laden der Schriften ändern sich die Texthöhen über der Karte
    document.fonts?.ready.then(() => {
      if (aktiv !== z) return;
      aufGeraetepixel(element);
      karte.invalidateSize(false);
    });
    karte.on('focus', () => karte.scrollWheelZoom.enable());
    karte.on('blur', mausrad);
    const beruehrt = () => (z.beruehrt = true);
    element.addEventListener('pointerdown', beruehrt, { once: true });
    element.addEventListener('wheel', beruehrt, { once: true, passive: true });

    hinzufuegen(z, JSON.parse(element.dataset.orte || '[]'));
    einpassen(z);

    // ?ort=… öffnet einen Ort (z. B. vom Beitrag aus), ?empfehlen startet das Empfehlen
    const parameter = new URLSearchParams(location.search);
    const ziel = parameter.get('ort');
    if (ziel && z.marker.has(ziel)) auswaehlen(z, ziel, true);
    if (z.api) {
      const spaetestens = window.setTimeout(kachelnLaden, 1200);
      empfehlungenLaden(z).then(() => {
        window.clearTimeout(spaetestens);
        if (aktiv !== z) return;
        if (!z.gewaehlt && !z.beruehrt && !buehne.classList.contains('waehlt')) {
          if (ziel && z.marker.has(ziel)) auswaehlen(z, ziel, true);
          else einpassen(z);
        }
        kachelnLaden();
      });
    } else kachelnLaden();

    karte.on('click', (e: L.LeafletMouseEvent) => {
      if (buehne.classList.contains('waehlt')) karte.panTo(e.latlng, { animate: !bewegungArm() });
      else schliessen(z);
    });
    karte.on('movestart', () => buehne.classList.add('bewegt'));
    karte.on('moveend', () => buehne.classList.remove('bewegt'));

    // Ein Tipp zeigt nur diese Art, ein zweiter wieder alle
    document.querySelectorAll<HTMLElement>('[data-filter]').forEach((k) =>
      k.addEventListener('click', () => {
        const art = k.dataset.filter as Art;
        filtern(z, z.filter === art ? 'alle' : art);
        if (!z.gewaehlt && z.orte.some((o) => z.filter === 'alle' || o.art === z.filter)) einpassen(z);
      }),
    );
    z.ortkarte.querySelector('[data-ortkarte-zu]')?.addEventListener('click', () => schliessen(z));
    z.ortkarte.querySelector('[data-k="mehr"]')?.addEventListener('click', (e) => {
      z.ortkarte.classList.add('ganz');
      (e.currentTarget as HTMLElement).hidden = true;
    });
    const liste = document.querySelector<HTMLElement>('[data-ortsliste]');
    liste?.addEventListener('click', (e) => {
      const knopf = (e.target as Element).closest<HTMLElement>('[data-zeige]');
      if (!knopf?.dataset.zeige) return;
      sichtbarMachen(buehne);
      auswaehlen(z, knopf.dataset.zeige, true);
    });
    liste?.addEventListener('mouseover', (e) => hervorheben(z, (e.target as Element).closest<HTMLElement>('[data-zeige]')?.dataset.zeige ?? null));
    liste?.addEventListener('mouseleave', () => hervorheben(z, null));

    if (!z.api) return;

    // Verwalten auf Johannes' Gerät: Löschen mit zweitem Tipp zur Sicherheit
    const k = <T extends HTMLElement = HTMLElement>(name: string) => z.ortkarte.querySelector<T>(`[data-k="${name}"]`)!;
    let loeschenZeit = 0;
    k('loeschen').addEventListener('click', () => {
      const knopf = k('loeschen');
      if (!z.gewaehlt) return;
      if (!knopf.classList.contains('sicher')) {
        knopf.classList.add('sicher');
        k('loeschen-text').textContent = 'Wirklich löschen?';
        window.clearTimeout(loeschenZeit);
        loeschenZeit = window.setTimeout(() => {
          knopf.classList.remove('sicher');
          k('loeschen-text').textContent = 'Löschen';
        }, 4000);
        return;
      }
      window.clearTimeout(loeschenZeit);
      loeschen(z, z.gewaehlt);
    });

    document.querySelectorAll('[data-empfehlen]').forEach((k) => k.addEventListener('click', () => waehlenStarten(z)));
    document.querySelector('[data-abbrechen]')?.addEventListener('click', () => waehlenBeenden(z));
    document.querySelector('[data-hier]')?.addEventListener('click', () => hierIstEs(z));
    document.querySelector('[data-standort]')?.addEventListener('click', () => {
      navigator.geolocation?.getCurrentPosition(
        (pos) => {
          karte.setView([pos.coords.latitude, pos.coords.longitude], 17, { animate: !bewegungArm() });
          wahlText(WAHL_TEXT);
        },
        () => wahlText('Dein Standort ist nicht verfügbar. Such den Ort oder schieb die Karte hin.'),
        { enableHighAccuracy: true, timeout: 10000, maximumAge: 60000 },
      );
    });
    document.querySelector('[data-suche]')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const feld = (e.currentTarget as HTMLFormElement).elements.namedItem('q') as HTMLInputElement;
      suchen(z, feld.value);
    });
    const dialog = document.querySelector<HTMLDialogElement>('[data-dialog]');
    dialog?.querySelector('[data-schliessen]')?.addEventListener('click', () => dialog.close());
    // Tipp neben das Sheet schließt es
    dialog?.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    document.querySelector<HTMLFormElement>('[data-formular]')?.addEventListener('submit', (e) => {
      e.preventDefault();
      senden(z, e.currentTarget as HTMLFormElement);
    });
    if (parameter.has('empfehlen')) waehlenStarten(z);
  }

  const w = window as Window & { __jbBrixmap?: boolean };
  if (!w.__jbBrixmap) {
    w.__jbBrixmap = true;
    document.addEventListener('astro:page-load', einrichten);
    // Escape schließt die Ortskarte bzw. bricht das Empfehlen ab (offene Dialoge schließen sich selbst)
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !aktiv || document.querySelector('dialog[open]')) return;
      if (aktiv.buehne.classList.contains('waehlt')) waehlenBeenden(aktiv);
      else schliessen(aktiv);
    });
    // Beim Verlassen der Seite die Karte sauber abbauen
    document.addEventListener('astro:before-swap', () => {
      aktiv?.karte.remove();
      aktiv = null;
      window.clearTimeout(toastZeit);
    });
  }
  einrichten();
</script>
