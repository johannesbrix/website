---
// Brixmap: Johannes' Orte (orange, Sonne) und Empfehlungen von Besuchern (anthrazit, Rakete).
// Aufgebaut wie eine Karten-App: am Handy die Karte und darunter die Liste, ab 1000 px die Liste links
// und die Karte rechts. Ein Tipp auf einen Pin öffnet die Ortskarte. „Empfehlen“ legt einen Pin in die
// Kartenmitte, unter dem man die Karte verschiebt; danach kommt das Formular als Sheet. Empfehlungen
// erscheinen sofort. Auf Johannes' freigeschaltetem Gerät heißt der Knopf „Ort setzen“, der Pin ist
// die Sonne, und an jeder Ortskarte kann er löschen (docs/brixmap.md).
// Die Kartenkacheln kommen von OpenStreetMap (nur auf dieser Seite). Empfehlen und die Ortssuche laufen
// über den kleinen Server in api/. Ohne Server zeigt die Karte nur Johannes' Orte.
import 'leaflet/dist/leaflet.css';
import { getEntry, render } from 'astro:content';
import Basis from '../layouts/Basis.astro';
import Icon from '../components/Icon.astro';
import Pin from '../components/Pin.astro';
import { klartext, kurz, meineOrte } from '../lib/inhalt';
import { ARTEN, KATEGORIE_IDS, KATEGORIEN, type Art } from '../lib/brixmap';
import { API } from '../lib/dienste';

const seite = await getEntry('seiten', 'brixmap');
const Intro = seite?.body?.trim() ? (await render(seite)).Content : undefined;
const text = klartext(seite?.body);
const beschreibung = text && !text.startsWith('[') ? kurz(text) : undefined;
const orte = await meineOrte();
const arten = Object.keys(ARTEN) as Art[];
---

<Basis titel={seite?.data.titel ?? 'Brixmap'} beschreibung={beschreibung} platte="weg">
  <link rel="preconnect" href="https://tile.openstreetmap.de" slot="head" />

  <div class="brixmap">
    <header class="bm-kopf">
      <h1 class="bm-titel">Brixmap<span class="punkt" aria-hidden="true"></span></h1>
      {
        Intro && (
          <div class="text bm-intro">
            <Intro />
          </div>
        )
      }
    </header>

    <div class="buehne" data-buehne>
      <div class="karte" data-karte data-orte={JSON.stringify(orte)} data-api={API || undefined} role="region" aria-label="Karte"></div>

      {/* Zugleich Legende: ohne Auswahl sind alle Orte zu sehen, ein Tipp zeigt nur diese Art */}
      <div class="oben">
        <div class="filter" role="group" aria-label="Orte filtern">
          {
            arten.map((art) => (
              <button class="chip" type="button" aria-pressed="false" data-filter={art}>
                <Pin art={art} />
                {ARTEN[art].name}
              </button>
            ))
          }
        </div>
      </div>

      <div class="unten">
        <a class="pill leise zur-liste" href="#orte"><Icon name="liste" />Liste</a>
        {
          API && (
            <button class="pill" type="button" data-empfehlen>
              <Icon name="plus" />
              <span data-empfehlen-text>Empfehlen</span>
            </button>
          )
        }
      </div>

      {/* Ortskarte: kompakt, lange Texte erst nach „Mehr“. Route und Schließen als Icons oben rechts. */}
      <article class="ortkarte" data-ortkarte tabindex="-1" aria-labelledby="ortkarte-name" hidden>
        <div class="ortkarte-kopf">
          <p class="ortkarte-art"><span data-k="pin"></span><span data-k="art"></span></p>
          <a class="icon-knopf" href="#" aria-label="Route planen" title="Route planen" data-k="route"><Icon name="route" /></a>
          <button class="icon-knopf" type="button" aria-label="Schließen" data-ortkarte-zu>
            <Icon name="schliessen" />
          </button>
        </div>
        <h2 class="ortkarte-name" id="ortkarte-name" data-k="name"></h2>
        <p class="ortkarte-kategorie" data-k="kategorie" hidden></p>
        <p class="ortkarte-notiz kurz" data-k="notiz" hidden></p>
        <button class="ortkarte-mehr" type="button" data-k="mehr" hidden>Mehr anzeigen</button>
        <a class="pill leise ortkarte-link" href="#" data-k="link" hidden>
          <Icon name="weiter" class="intern" />
          <Icon name="extern" class="extern" />
          <span data-k="linktext"></span>
        </a>
        {/* Nur auf Johannes' freigeschaltetem Gerät (docs/brixmap.md) */}
        {
          API && (
            <div class="verwalten" data-k="verwalten" hidden>
              <button class="pill leise loeschen" type="button" data-k="loeschen">
                <Icon name="loeschen" />
                <span data-k="loeschen-text">Löschen</span>
              </button>
            </div>
          )
        }
      </article>

      {
        API && (
          <>
            {/* Pin in der Kartenmitte: Rakete für Besucher, auf Johannes' Gerät die Sonne (geraetAnzeigen) */}
            <div class="fadenkreuz" aria-hidden="true">
              <span class="nadel" data-nadel>
                <Pin art="empfehlung" />
              </span>
              <span class="nadel-schatten" />
            </div>
            <div class="wahl-oben">
              <form class="suche" role="search" data-suche>
                <button class="suche-los" type="submit" aria-label="Suchen">
                  <Icon name="suche" />
                </button>
                <label class="nur-sr" for="ortssuche">
                  Ort oder Adresse suchen
                </label>
                <input id="ortssuche" name="q" type="search" placeholder="Ort oder Adresse suchen" autocomplete="off" enterkeyhint="search" />
              </form>
              <button class="icon-knopf schwebend" type="button" aria-label="Mein Standort" title="Mein Standort" data-standort>
                <Icon name="standort" />
              </button>
              <ul class="liste treffer" aria-label="Suchergebnisse" data-treffer hidden />
            </div>
            <div class="wahl-unten">
              <p class="wahl-text" aria-live="polite" data-wahl-text>
                Schieb die Karte, bis der Pin auf dem Ort sitzt.
              </p>
              <div class="wahl-knoepfe">
                <button class="pill leise" type="button" data-abbrechen>
                  Abbrechen
                </button>
                <button class="pill" type="button" data-hier>
                  Hier ist es
                </button>
              </div>
            </div>
          </>
        )
      }

      <p class="toast" role="status" data-toast></p>
    </div>

    <section class="bm-liste" id="orte" aria-labelledby="orte-titel">
      <h2 class="bm-liste-titel" id="orte-titel">Orte <span class="anzahl" data-anzahl>{orte.length}</span></h2>
      <ul class="liste ortsliste" data-ortsliste>
        {
          orte.map((ort) => (
            <li data-art={ort.art}>
              <button class="ort" type="button" data-zeige={ort.id}>
                <Pin art={ort.art} />
                <span class="ort-text">
                  <span class="ort-name">{ort.name}</span>
                  <span class="ort-meta">
                    <span>{ARTEN[ort.art].name}</span>
                    {ort.kategorie && <span>{KATEGORIEN[ort.kategorie]}</span>}
                  </span>
                  {ort.notiz && <span class="ort-notiz">{ort.notiz}</span>}
                </span>
              </button>
            </li>
          ))
        }
      </ul>
      <div class="leer" data-leer hidden={orte.length > 0}>
        <p>Noch keine Orte.</p>
        {
          API && (
            <button class="pill leise" type="button" data-empfehlen>
              <Icon name="plus" />
              Ort empfehlen
            </button>
          )
        }
      </div>
    </section>
  </div>

  {/* Vorlagen für das Kartenskript: dieselben Pins und Icons wie im HTML */}
  {arten.map((art) => <template data-vorlage={`pin-${art}`}><Pin art={art} /></template>)}
  {KATEGORIE_IDS.map((id) => <template data-vorlage={`kategorie-${id}`}><Icon name={id} /></template>)}

  {
    API && (
      <dialog class="sheet" aria-labelledby="empfehlen-titel" data-dialog>
        <div class="sheet-kopf">
          <h2 class="sheet-titel" id="empfehlen-titel" data-sheet-titel>
            Ort empfehlen
          </h2>
          <button class="icon-knopf" type="button" aria-label="Schließen" data-schliessen>
            <Icon name="schliessen" />
          </button>
        </div>
        <form class="formular" data-formular>
          <label class="feld">
            <span class="feld-name">Name des Orts</span>
            <input name="name" required minlength="2" maxlength="80" autocomplete="off" />
          </label>
          <fieldset class="feld">
            <legend class="feld-name">Was ist es?</legend>
            <div class="chips">
              {KATEGORIE_IDS.map((id) => (
                <label class="chip wahl">
                  <input type="radio" name="kategorie" value={id} required />
                  <Icon name={id} />
                  {KATEGORIEN[id]}
                </label>
              ))}
            </div>
          </fieldset>
          <label class="feld">
            <span class="feld-name" data-notiz-name>Warum empfiehlst du ihn?</span>
            <textarea name="notiz" required minlength="3" maxlength="300" rows="3" />
          </label>
          <label class="feld" data-nur-besucher>
            <span class="feld-name">
              Dein Name <span class="leise">(optional)</span>
            </span>
            <input name="von" maxlength="40" autocomplete="given-name" />
          </label>
          <label class="honig" aria-hidden="true">
            Website
            <input name="website" tabindex="-1" autocomplete="off" />
          </label>
          <label class="einwilligung" data-nur-besucher>
            <input type="checkbox" name="einwilligung" required />
            <span>
              Ich bin einverstanden, dass meine Empfehlung und, falls angegeben, mein Name sofort öffentlich auf der Brixmap
              erscheinen. Mehr dazu im <a href="/datenschutz/#brixmap-und-klick-zähler">Datenschutz</a>.
            </span>
          </label>
          <p class="fehler" role="alert" data-fehler hidden />
          <button class="pill senden" type="submit" data-senden>
            <Icon name="rakete" />
            Auf die Karte setzen
          </button>
        </form>
      </dialog>
    )
  }
</Basis>

<style>
  .brixmap {
    --rand: clamp(20px, 4.4cqi, 64px);
    --schatten: 0 0 0 1px color-mix(in srgb, var(--text) 9%, transparent), 0 6px 22px rgba(0, 0, 0, 0.16);
    --geteilt: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'kopf' 'buehne' 'liste';
  }

  /* Kopf */
  .bm-kopf {
    grid-area: kopf;
    padding: 8px var(--rand) 22px;
  }
  .bm-titel {
    font-weight: 700;
    font-size: clamp(46px, 5.4cqi, 68px);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }
  .bm-intro {
    max-width: 34em;
    margin-top: 12px;
    font-size: 17px;
    line-height: 1.55;
  }

  /* Bühne: Karte mit allem, was darüber schwebt */
  .buehne {
    grid-area: buehne;
    position: relative;
    height: clamp(400px, 70svh, 720px);
    /* Ganze Pixel, damit Leaflet die Kartenmitte genau trifft */
    height: round(down, clamp(400px, 70svh, 720px), 1px);
    overflow: hidden;
    background: var(--flaeche);
    isolation: isolate;
  }
  /* Leaflet setzt .leaflet-container auf dasselbe Element; die Klasse hier gewinnt */
  .karte {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--flaeche);
    font: 15px/1.4 var(--grotesk);
  }
  /* Ruhige Kacheln, damit die Pins leuchten; im Dunkelmodus dunkel */
  .karte :global(.leaflet-tile-pane) {
    filter: grayscale(0.85) contrast(0.94) brightness(1.03);
  }
  /* Leaflet 1.9.4 legt die Kacheln mit plus-lighter übereinander, gegen Spalten bei krummen Positionen.
     Die Karte steht hier dank aufGeraetepixel() auf ganzen Pixeln; plus-lighter würde dann helle
     Linien an den Kachelgrenzen erzeugen. */
  .karte :global(img.leaflet-tile) {
    mix-blend-mode: normal;
  }
  @media (prefers-color-scheme: dark) {
    .karte :global(.leaflet-tile-pane) {
      filter: grayscale(0.7) invert(1) hue-rotate(180deg) brightness(0.85) contrast(0.9);
    }
  }

  /* Pins auf der Karte: 30 px sichtbar, 44 px zum Antippen */
  .karte :global(.marker) {
    display: grid;
    place-items: center;
  }
  .karte :global(.marker .pin) {
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25), 0 3px 10px rgba(0, 0, 0, 0.18);
    transition: transform 0.18s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.18s;
  }
  .karte :global(.marker.hervor .pin) {
    transform: scale(1.15);
  }
  @media (hover: hover) {
    .karte :global(.marker:hover .pin) {
      transform: scale(1.15);
    }
  }
  .karte :global(.marker.aktiv .pin) {
    transform: scale(1.3);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--orange) 30%, transparent), 0 3px 12px rgba(0, 0, 0, 0.25);
  }
  .karte :global(.marker:focus-visible) {
    outline: none;
  }
  .karte :global(.marker:focus-visible .pin) {
    outline: 2px solid var(--orange);
    outline-offset: 3px;
  }

  /* Bedienelemente von Leaflet */
  .karte :global(.leaflet-control-attribution) {
    padding: 1px 8px;
    border-radius: 8px 0 0 0;
    background: color-mix(in srgb, var(--grund) 82%, transparent);
    color: var(--leise);
    font-size: 11px;
  }
  .karte :global(.leaflet-control-attribution a) {
    color: inherit;
  }
  .karte :global(.leaflet-bar) {
    margin: 0 16px 14px 0;
    border: 0;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: var(--schatten);
  }
  .karte :global(.leaflet-bar a) {
    width: 42px;
    height: 42px;
    border-color: var(--linie);
    background: var(--grund);
    color: var(--text);
    font: 400 22px/42px var(--grotesk);
  }
  @media (hover: hover) {
    .karte :global(.leaflet-bar a:hover) {
      background: var(--flaeche);
    }
  }
  @media (pointer: coarse) {
    .karte :global(.leaflet-control-zoom) {
      display: none;
    }
  }

  /* Was über der Karte schwebt */
  .oben {
    position: absolute;
    z-index: 2;
    top: 8px;
    left: 0;
    right: 0;
  }
  .filter {
    display: flex;
    gap: 8px;
    padding: 4px 12px 12px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .filter::-webkit-scrollbar {
    display: none;
  }
  .filter .chip,
  .schwebend {
    border-color: transparent;
    background: var(--grund);
    box-shadow: var(--schatten);
  }
  .filter .chip[aria-pressed='true'] {
    background: var(--text);
    color: var(--grund);
  }
  .filter :global(.pin) {
    width: 20px;
    height: 20px;
    margin-left: -6px;
    border-width: 1.5px;
  }
  .filter :global(.pin .icon) {
    width: 11px;
    height: 11px;
    margin: 0;
  }
  .unten {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: 28px;
    display: flex;
    gap: 8px;
    transform: translateX(-50%);
  }
  .unten .pill {
    box-shadow: var(--schatten);
    white-space: nowrap;
  }
  .unten .pill.leise {
    background: var(--grund);
  }
  .buehne.mit-karte .unten,
  .buehne.waehlt .oben,
  .buehne.waehlt .unten {
    display: none;
  }

  /* Ortskarte: unten auf der Karte, am Handy über die ganze Breite */
  .ortkarte {
    position: absolute;
    z-index: 3;
    left: 12px;
    right: 12px;
    bottom: 24px;
    max-height: calc(100% - 96px);
    box-sizing: border-box;
    padding: 18px 20px 20px;
    overflow-y: auto;
    overscroll-behavior: contain;
    border-radius: var(--r-gross);
    background: var(--grund);
    box-shadow: var(--schatten);
    animation: hoch 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .ortkarte[hidden] {
    display: none;
  }
  .ortkarte:focus {
    outline: none;
  }
  @keyframes hoch {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
  .ortkarte-kopf {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: -6px -8px 0 0;
  }
  .ortkarte-kopf .icon-knopf {
    width: 40px;
    height: 40px;
  }
  .ortkarte-art {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 10px;
    min-width: 0;
    font-size: 14px;
    font-weight: 600;
    color: var(--leise);
  }
  .ortkarte-art :global(.pin) {
    width: 26px;
    height: 26px;
  }
  .ortkarte-art :global(.pin .icon) {
    width: 13px;
    height: 13px;
  }
  .ortkarte-name {
    margin-top: 6px;
    font-weight: 700;
    font-size: clamp(22px, 2.2cqi, 28px);
    letter-spacing: -0.03em;
    line-height: 1.12;
    overflow-wrap: anywhere;
  }
  .ortkarte-kategorie {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 8px;
    font-size: 15px;
    color: var(--leise);
  }
  .ortkarte-kategorie :global(.icon) {
    width: 17px;
    height: 17px;
  }
  .ortkarte-notiz {
    margin-top: 10px;
    font-family: var(--lese);
    font-size: 16px;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  /* Lange Texte: drei Zeilen, der Rest nach „Mehr anzeigen“ */
  .kurz {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }
  .ortkarte.ganz .kurz {
    display: block;
    -webkit-line-clamp: unset;
    line-clamp: none;
  }
  .ortkarte-mehr {
    margin-top: 4px;
    padding: 6px 0;
    border: 0;
    background: none;
    color: var(--text);
    font: 600 14px var(--grotesk);
    text-decoration: underline;
    text-decoration-color: var(--orange);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    cursor: pointer;
  }
  .ortkarte [hidden] {
    display: none;
  }
  .ortkarte-link,
  .verwalten .pill {
    min-height: 44px;
    padding: 0 18px;
    font-size: 15px;
  }
  .ortkarte-link {
    margin-top: 14px;
  }
  /* Nur auf Johannes' Gerät: verwalten direkt an der Karte */
  .verwalten {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--linie);
  }
  /* Zweiter Tipp nötig: gefüllt und mit Rückfrage, in den Farben der Seite */
  .verwalten .loeschen.sicher {
    background: var(--text);
    color: var(--grund);
  }
  .formular [hidden] {
    display: none;
  }
  .ortkarte-link :global(.extern),
  .ortkarte-link.nach-aussen :global(.intern) {
    display: none;
  }
  .ortkarte-link.nach-aussen :global(.extern) {
    display: inline-flex;
  }

  /* Ort wählen: Pin in der Mitte, die Karte bewegt sich darunter */
  .fadenkreuz,
  .wahl-oben,
  .wahl-unten {
    display: none;
  }
  .buehne.waehlt .fadenkreuz {
    display: block;
  }
  .buehne.waehlt .wahl-oben {
    display: flex;
  }
  .buehne.waehlt .wahl-unten {
    display: grid;
  }
  .buehne.waehlt .karte :global(.leaflet-marker-icon.leaflet-interactive) {
    opacity: 0.4;
    pointer-events: none;
  }
  .fadenkreuz {
    position: absolute;
    z-index: 2;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    pointer-events: none;
  }
  .nadel {
    position: absolute;
    left: 0;
    bottom: 0;
    display: grid;
    justify-items: center;
    transform: translateX(-50%);
    transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .nadel :global(.pin) {
    width: 42px;
    height: 42px;
    border-width: 3px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.28);
  }
  .nadel :global(.pin .icon) {
    width: 20px;
    height: 20px;
  }
  .nadel::after {
    content: '';
    width: 3px;
    height: 14px;
    margin-top: -2px;
    border-radius: 0 0 2px 2px;
    background: var(--text);
  }
  .nadel-schatten {
    position: absolute;
    left: 0;
    top: 0;
    width: 12px;
    height: 5px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.35);
    transform: translate(-50%, -50%);
    transition: transform 0.2s, opacity 0.2s;
  }
  .buehne.bewegt .nadel {
    transform: translate(-50%, -12px);
  }
  .buehne.bewegt .nadel-schatten {
    opacity: 0.5;
    transform: translate(-50%, -50%) scale(1.5);
  }
  .wahl-oben {
    position: absolute;
    z-index: 3;
    top: 12px;
    left: 12px;
    right: 12px;
    gap: 8px;
  }
  .suche {
    display: flex;
    flex: 1;
    align-items: center;
    min-width: 0;
    height: 48px;
    border-radius: 999px;
    background: var(--grund);
    box-shadow: var(--schatten);
  }
  .suche:focus-within {
    box-shadow: 0 0 0 2px var(--orange), 0 6px 22px rgba(0, 0, 0, 0.16);
  }
  .suche-los {
    display: grid;
    flex: none;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
  }
  .suche-los :global(.icon) {
    width: 20px;
    height: 20px;
  }
  .suche input {
    flex: 1;
    min-width: 0;
    height: 100%;
    padding: 0 16px 0 0;
    border: 0;
    background: none;
    color: var(--text);
    font: 400 16px var(--grotesk);
    outline: none;
  }
