---
// Einzelner Moment: wie die Beitragsseite, aber ohne Fakten, Updates und Galerie.
import { render } from 'astro:content';
import Basis from '../../layouts/Basis.astro';
import Foto from '../../components/Foto.astro';
import { datum, isoDatum, klartext, kurz, momente, teilbild, type Moment } from '../../lib/inhalt';

export async function getStaticPaths() {
  return (await momente()).map((moment) => ({ params: { slug: moment.id }, props: { moment } }));
}

interface Props {
  moment: Moment;
}

const { moment } = Astro.props;
const { titel, ort, bild, bild_alt } = moment.data;
const { Content } = await render(moment);
const geschichte = klartext(moment.body);
const beschreibung = geschichte && !geschichte.startsWith('[') ? kurz(geschichte) : undefined;
---

<Basis titel={titel} beschreibung={beschreibung} bild={await teilbild(bild)} typ="article">
  <article>
    <div class="beitrag-kopf rahmen">
      <a class="zurueck" href="/momente/"><span class="nur-sr">Zurück zu </span>Momente</a>
      <h1 class="beitrag-titel">{titel}</h1>
      <p class="tags">
        <time datetime={isoDatum(moment.data.datum)}>{datum(moment.data.datum)}</time>
        {ort && <span>{ort}</span>}
      </p>
    </div>

    {
      bild && (
        <div class="rahmen">
          <figure class="titelbild">
            <Foto bild={bild} alt={bild_alt} breiten={[800, 1200, 1600]} sizes="(max-width: 1408px) 92vw, 1280px" sofort />
          </figure>
        </div>
      )
    }

    {
      moment.body?.trim() && (
        <div class="rahmen">
          <div class="lesen story text">
            <Content />
          </div>
        </div>
      )
    }
  </article>
</Basis>
