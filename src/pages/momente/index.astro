---
// Momente: kurze Geschichten über Begegnungen mit Menschen.
import Basis from '../../layouts/Basis.astro';
import MomenteListe from '../../components/MomenteListe.astro';
import { momente } from '../../lib/inhalt';

const liste = await momente();
---

<Basis titel="Momente">
  <div class="rahmen momente-kopf">
    <h1 class="momente-titel">Momente</h1>
  </div>
  <div class="rahmen">
    {liste.length > 0 ? <MomenteListe momente={liste} /> : <p class="leer">Noch keine Momente.</p>}
  </div>
</Basis>

<style>
  .momente-kopf {
    padding-block: clamp(24px, 5cqi, 72px) clamp(32px, 4cqi, 56px);
  }
  .momente-titel {
    font-weight: 700;
    font-size: clamp(58px, 9cqi, 132px);
    line-height: 0.92;
    letter-spacing: -0.05em;
  }
  .leer {
    color: var(--leise);
  }
</style>
