---
// Startseite: Intro mit Porträt, „Gerade dran“ (Liste), Bereiche (Kacheln), Rise-and-Shine-Band.
// Alle Inhalte kommen aus den Collections (docs/inhalte.md).
import { getEntry, render } from 'astro:content';
import Basis from '../layouts/Basis.astro';
import Foto from '../components/Foto.astro';
import Projektliste from '../components/Projektliste.astro';
import RiseBand from '../components/RiseBand.astro';
import { beitraege, bereiche, einstellungen, plattformen, teilbild } from '../lib/inhalt';
import { ARTEN } from '../lib/brixmap';
import { API } from '../lib/dienste';

const site = await einstellungen();
const alleBereiche = await bereiche();
const bereichNamen = Object.fromEntries(alleBereiche.map((b) => [b.id, b.data.titel]));
const geradeDran = (await beitraege()).filter((b) => b.data.aktiv).slice(0, 6);

// Der Schlusspunkt des Intros wird zur aufgehenden Sonne.
const intro = site.intro.trim();
const mitSonne = intro.endsWith('.');
const introText = mitSonne ? intro.slice(0, -1) : intro;

const brixmap = await getEntry('seiten', 'brixmap');
const BrixmapText = brixmap?.body?.trim() ? (await render(brixmap)).Content : undefined;

const portrait = await teilbild(site.portrait);
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: new URL('/', Astro.site).href,
  ...(portrait && { image: new URL(portrait.src, Astro.site).href }),
  sameAs: plattformen(site.links).map((l) => l.href),
};
---

<Basis abstand={false}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(person)} />

  <section class="held rahmen" aria-labelledby="name">
    {
      site.portrait && (
        <figure class="portrait">
          <Foto
            bild={site.portrait}
            alt={site.portrait_alt}
            breiten={[480, 800, 1200]}
            sizes="(max-width: 760px) 100vw, min(40vw, 545px)"
            sofort
          />
        </figure>
      )
    }
    <div>
      <h1 class="nur-sr" id="name">{site.name}</h1>
      <p class="aussage">{introText}{mitSonne && <span class="punkt sonne" aria-hidden="true" />}</p>
    </div>
  </section>

  {
    geradeDran.length > 0 && (
      <section class="abschnitt rahmen" aria-labelledby="gerade">
        <h2 class="titel" id="gerade">Gerade dran</h2>
        <Projektliste beitraege={geradeDran} bereichNamen={bereichNamen} />
      </section>
    )
  }

  <section class="abschnitt rahmen" aria-labelledby="bereiche">
    <h2 class="titel" id="bereiche">Bereiche</h2>
    <ul class="liste raster">
      {
        alleBereiche.map((b) => (
          <li>
            <a class="kachel" href={`/${b.id}/`}>
              <Foto bild={b.data.bild} breiten={[300, 600]} sizes="(max-width: 760px) 50vw, 300px" />
              <span class="kachel-name">{b.data.titel}</span>
              {b.data.untertitel && <span class="kachel-info">{b.data.untertitel}</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="abschnitt rahmen" aria-labelledby="brixmap-titel">
    <p class="pins" aria-hidden="true">
      {Object.values(ARTEN).map((art) => <span>{art.emoji}</span>)}
    </p>
    <h2 class="titel" id="brixmap-titel">Brixmap</h2>
    {
      BrixmapText && (
        <div class="text brixmap-text">
          <BrixmapText />
        </div>
      )
    }
    <p class="brixmap-knoepfe">
      <a class="pill" href="/brixmap/">Karte ansehen</a>
      {API && <a class="pill leise" href="/brixmap/?empfehlen">Ort empfehlen</a>}
    </p>
  </section>

  <RiseBand />
</Basis>

<style>
  .held {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(28px, 5cqi, 88px);
    align-items: center;
    padding-block: clamp(8px, 2cqi, 24px) clamp(56px, 8cqi, 120px);
  }
  .portrait :global(.bild) {
    aspect-ratio: 4 / 5;
    object-position: 50% 40%;
    border-radius: var(--r-gross);
  }
  .aussage {
    font-weight: 500;
    font-size: clamp(29px, 3.5cqi, 50px);
    line-height: 1.1;
    letter-spacing: -0.025em;
  }
  /* Aufgehende Sonne: die einzige automatische Animation außer der fliegenden Platte */
  .sonne {
    animation: aufgehen 1.6s cubic-bezier(0.2, 0.75, 0.25, 1) 0.5s both;
  }
  @keyframes aufgehen {
    from {
      transform: translateY(0.6em);
      opacity: 0;
    }
    45% {
      opacity: 1;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sonne {
      animation: none;
    }
  }

  .raster {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(150px, 100%), 1fr));
    gap: clamp(22px, 3cqi, 40px) clamp(14px, 2cqi, 28px);
  }
  .kachel {
    display: block;
    text-decoration: none;
  }
  .kachel :global(.bild) {
    aspect-ratio: 1 / 1;
  }
  .kachel-name {
    display: block;
    margin-top: 14px;
    font-weight: 600;
    font-size: clamp(22px, 2.6cqi, 34px);
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .kachel:hover .kachel-name {
    text-decoration: underline;
    text-decoration-color: var(--orange);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .kachel-info {
    display: block;
    margin-top: 5px;
    font-size: 15px;
    line-height: 1.4;
    color: var(--leise);
  }

  /* Brixmap-Hinweis */
  .pins {
    display: flex;
    gap: 8px;
    margin-bottom: 18px;
  }
  .pins span {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--linie);
    border-radius: 50%;
    background: var(--grund);
    font-size: 22px;
    line-height: 1;
  }
  .brixmap-text {
    max-width: 34em;
  }
  .brixmap-knoepfe {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: clamp(20px, 2.4cqi, 28px);
  }

  @container (max-width: 760px) {
    .held {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 0;
    }
    .held .portrait {
      margin-inline: calc(-1 * clamp(20px, 4.4cqi, 64px));
    }
    .portrait :global(.bild) {
      border-radius: 0;
    }
  }
</style>
