---
// Startseite: Intro mit Porträt und den drei Türen, „Gerade dran“ (Liste), Rise-and-Shine-Band,
// Brixmap-Hinweis. Alle Inhalte kommen aus den Collections (docs/inhalte.md).
// Die Bereiche haben hier keinen eigenen Abschnitt mehr (Johannes, 22.11.2026); sie sind über
// „Projekte“ und die Filter dort erreichbar.
import { getEntry, render } from 'astro:content';
import Basis from '../layouts/Basis.astro';
import Foto from '../components/Foto.astro';
import Icon from '../components/Icon.astro';
import Pin from '../components/Pin.astro';
import Projektliste from '../components/Projektliste.astro';
import RiseBand from '../components/RiseBand.astro';
import { beitraege, bereiche, einstellungen, plattformen, teilbild } from '../lib/inhalt';
import { API } from '../lib/dienste';
import type { IconName } from '../lib/icons';

const site = await einstellungen();
const bereichNamen = Object.fromEntries((await bereiche()).map((b) => [b.id, b.data.titel]));
const geradeDran = (await beitraege()).filter((b) => b.data.aktiv).slice(0, 6);

// Der Schlusspunkt des Intros wird zur aufgehenden Sonne.
const intro = site.intro.trim();
const mitSonne = intro.endsWith('.');
const introText = mitSonne ? intro.slice(0, -1) : intro;

const tueren: { name: string; href: string; icon: IconName }[] = [
  { name: 'Projekte', href: '/projekte/', icon: 'projekte' },
  { name: 'Rise & Shine', href: '/rise-and-shine/', icon: 'rise' },
  { name: 'Brixmap', href: '/brixmap/', icon: 'brixmap' },
];

const brixmap = await getEntry('seiten', 'brixmap');
const BrixmapText = brixmap?.body?.trim() ? (await render(brixmap)).Content : undefined;

const portrait = await teilbild(site.portrait);
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: new URL('/', Astro.site).href,
  ...(portrait && { image: new URL(portrait.src, Astro.site).href }),
  sameAs: plattformen(site.links).map((l) => l.href),
};
---

<Basis>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(person)} />

  <section class="held rahmen" aria-labelledby="name">
    {
      site.portrait && (
        <figure class="portrait">
          <Foto
            bild={site.portrait}
            alt={site.portrait_alt}
            breiten={[480, 800, 1200]}
            sizes="(max-width: 760px) 100vw, min(40vw, 545px)"
            sofort
          />
        </figure>
      )
    }
    <div>
      <h1 class="nur-sr" id="name">{site.name}</h1>
      <p class="aussage">{introText}{mitSonne && <span class="punkt sonne" aria-hidden="true" />}</p>
      <nav aria-label="Bereiche der Seite">
        <ul class="chips tueren">
          {
            tueren.map((t) => (
              <li>
                <a class="chip" href={t.href}>
                  <Icon name={t.icon} />
                  {t.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>

  {
    geradeDran.length > 0 && (
      <section class="abschnitt rahmen" aria-labelledby="gerade">
        <div class="abschnitt-kopf">
          <h2 class="titel" id="gerade">
            Gerade dran
          </h2>
          <a class="mehr-link" href="/projekte/">
            Alle Projekte
          </a>
        </div>
        <Projektliste beitraege={geradeDran} bereichNamen={bereichNamen} />
      </section>
    )
  }

  <RiseBand />

  <section class="abschnitt rahmen" aria-labelledby="brixmap-titel">
    <div class="brixmap-karte">
      <p class="brixmap-pins" aria-hidden="true">
        <Pin art="ich" />
        <Pin art="empfehlung" />
      </p>
      <h2 class="titel" id="brixmap-titel">Brixmap</h2>
      {
        BrixmapText && (
          <div class="text brixmap-text">
            <BrixmapText />
          </div>
        )
      }
      <p class="brixmap-knoepfe">
        <a class="pill" href="/brixmap/">
          <Icon name="karte" />
          Karte öffnen
        </a>
        {
          API && (
            <a class="pill leise" href="/brixmap/?empfehlen">
              <Icon name="plus" />
              Ort empfehlen
            </a>
          )
        }
      </p>
    </div>
  </section>
</Basis>

<style>
  .held {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(28px, 5cqi, 88px);
    align-items: center;
    padding-block: clamp(8px, 2cqi, 24px) clamp(56px, 8cqi, 120px);
  }
  .portrait :global(.bild) {
    aspect-ratio: 4 / 5;
    object-position: 50% 40%;
    border-radius: var(--r-gross);
  }
  .aussage {
    font-weight: 500;
    font-size: clamp(29px, 3.5cqi, 50px);
    line-height: 1.1;
    letter-spacing: -0.025em;
  }
  /* Aufgehende Sonne: die einzige automatische Animation außer der fliegenden Platte */
  .sonne {
    animation: aufgehen 1.6s cubic-bezier(0.2, 0.75, 0.25, 1) 0.5s both;
  }
  @keyframes aufgehen {
    from {
      transform: translateY(0.6em);
      opacity: 0;
    }
    45% {
      opacity: 1;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
  .tueren {
    margin-top: clamp(22px, 3cqi, 36px);
  }
  /* Am Handy drei gleich große Kacheln statt einer umbrechenden Chip-Reihe */
  @container (max-width: 760px) {
    .tueren {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .tueren .chip {
      flex-direction: column;
      align-items: flex-start;
      justify-content: space-between;
      gap: 14px;
      width: 100%;
      height: 100%;
      box-sizing: border-box;
      min-height: 88px;
      padding: 14px;
      border: 0;
      border-radius: var(--r);
      background: var(--flaeche);
      font-weight: 600;
      white-space: normal;
    }
    .tueren .chip :global(.icon) {
      width: 22px;
      height: 22px;
      margin: 0;
    }
  }

  .abschnitt-kopf {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: clamp(18px, 2.4cqi, 32px);
  }
  .abschnitt-kopf .titel {
    margin: 0;
  }
  .mehr-link {
    flex: none;
    padding-block: 10px;
    font-size: 15px;
    font-weight: 500;
    color: var(--leise);
    text-decoration: none;
  }
  .mehr-link:hover {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--orange);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  /* Brixmap-Hinweis als ruhige Karte */
  .brixmap-karte {
    padding: clamp(24px, 4cqi, 56px);
    border-radius: var(--r-gross);
    background: var(--flaeche);
  }
  .brixmap-pins {
    display: flex;
    margin-bottom: 20px;
  }
  .brixmap-pins :global(.pin) {
    width: 44px;
    height: 44px;
    margin-right: -8px;
    border-width: 3px;
    border-color: var(--flaeche);
  }
  .brixmap-pins :global(.pin .icon) {
    width: 20px;
    height: 20px;
  }
  .brixmap-text {
    max-width: 34em;
  }
  .brixmap-knoepfe {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: clamp(20px, 2.4cqi, 28px);
  }
  .brixmap-knoepfe .pill.leise {
    background: var(--grund);
  }

  @container (max-width: 760px) {
    .held {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      padding-top: 0;
    }
    .held .portrait {
      margin-inline: calc(-1 * clamp(20px, 4.4cqi, 64px));
    }
    /* Am Handy quadratisch: Gesicht, Satz und die drei Türen passen auf den ersten Bildschirm */
    .portrait :global(.bild) {
      aspect-ratio: 1 / 1;
      object-position: 50% 85%;
      border-radius: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sonne {
      animation: none;
    }
  }
</style>
