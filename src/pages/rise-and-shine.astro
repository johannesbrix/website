---
// Rise & Shine: alles, was motiviert. Oben das Band mit Zitatkarte und Klick-Knopf, dann Johannes'
// Geschichte mit dem Video, das alles angestoßen hat. Danach je ein Regal für Zitate, Videos, Reden
// und Bücher: waagerecht wischbar, damit jede Reihe kurz bleibt, egal wie viel drin ist, und man
// ohne Sprungleiste an alles kommt (Johannes, 22.11.2026). Leere Regale erscheinen nicht.
import { getEntry, render } from 'astro:content';
import Basis from '../layouts/Basis.astro';
import RiseBand from '../components/RiseBand.astro';
import Regal from '../components/Regal.astro';
import Video from '../components/Video.astro';
import Foto from '../components/Foto.astro';
import Icon from '../components/Icon.astro';
import { buecher, einstellungen, videos, zitate } from '../lib/inhalt';
import type { IconName } from '../lib/icons';

const site = await einstellungen();
const seite = await getEntry('seiten', 'rise-and-shine');
const Geschichte = seite?.body?.trim() ? (await render(seite)).Content : undefined;
const alleVideos = await videos();
const hauptvideo = alleVideos.find((v) => v.geschichte);
const zitatListe = await zitate();
const buchListe = await buecher();
const videoRegale: { id: string; titel: string; icon: IconName; liste: typeof alleVideos }[] = [
  { id: 'videos', titel: 'Videos', icon: 'abspielen', liste: alleVideos.filter((v) => v !== hauptvideo && v.art === 'motivation') },
  { id: 'reden', titel: 'Reden', icon: 'rede', liste: alleVideos.filter((v) => v !== hauptvideo && v.art === 'rede') },
];
---

<Basis titel={seite?.data.titel ?? site.motto ?? 'Rise and Shine'} beschreibung={site.motto_text}>
  <RiseBand ebene="h1" oben />

  {
    (Geschichte || hauptvideo) && (
      <section class="rahmen abschnitt" id="geschichte" aria-labelledby="geschichte-titel">
        <h2 class="titel" id="geschichte-titel">
          Warum Rise and Shine
        </h2>
        <div class:list={['geschichte', { 'mit-video': Geschichte && hauptvideo }]}>
          {Geschichte && (
            <div class="lesen text motto-text">
              <Geschichte />
            </div>
          )}
          {hauptvideo && <Video titel={hauptvideo.titel} id={hauptvideo.id} von={hauptvideo.von} warum={hauptvideo.warum} gross />}
        </div>
      </section>
    )
  }

  {
    zitatListe.length > 0 && (
      <Regal id="zitate" titel="Zitate" anzahl={zitatListe.length} class="zitate">
        {zitatListe.map((zitat) => (
          <li>
            <figure class="zitat-karte">
              <Icon name="zitat" class="zitat-zeichen" />
              <blockquote class="zitat">„{zitat.text}“</blockquote>
              {(zitat.von || zitat.quelle) && <figcaption class="quelle">{[zitat.von, zitat.quelle].filter(Boolean).join(', ')}</figcaption>}
            </figure>
          </li>
        ))}
      </Regal>
    )
  }

  {
    videoRegale
      .filter((r) => r.liste.length > 0)
      .map((r) => (
        <Regal id={r.id} titel={r.titel} anzahl={r.liste.length} class="videos">
          {r.liste.map((v) => (
            <li>
              <a class="videokarte" href={v.link}>
                <span class="videokarte-flaeche">
                  <span class="videokarte-icon">
                    <Icon name={r.icon} />
                  </span>
                  <span class="videokarte-titel">{v.titel}</span>
                </span>
                <span class="videokarte-von">
                  {v.von}
                  <Icon name="extern" class="videokarte-extern" />
                </span>
              </a>
              {v.warum && <p class="videokarte-warum">{v.warum}</p>}
            </li>
          ))}
        </Regal>
      ))
  }

  {
    buchListe.length > 0 && (
      <Regal id="buecher" titel="Bücher" anzahl={buchListe.length} class="buecher">
        {buchListe.map((buch, i) => {
          // Mit Link ist das ganze Buch klickbar. Das typografische Cover zeigt Titel und Autor
          // schon, darunter stehen sie dann nur für Screenreader.
          const Huelle = buch.link ? 'a' : 'div';
          return (
            <li class="buch">
              <Huelle class="buch-huelle" href={buch.link}>
                {buch.foto ? (
                  <Foto bild={buch.foto} alt={buch.foto_alt} breiten={[200, 400]} sizes="160px" class="buch-bild" />
                ) : (
                  <span class:list={['buch-cover', i % 2 ? 'papier' : 'dunkel']} aria-hidden="true">
                    <span class="buch-cover-titel">{buch.titel}</span>
                    {buch.autor && <span class="buch-cover-autor">{buch.autor}</span>}
                  </span>
                )}
                <span class:list={['buch-name', { 'nur-sr': !buch.foto }]}>
                  <span class="buch-titel">{buch.titel}</span>
                  {buch.autor && <span class="buch-autor">{buch.autor}</span>}
                </span>
              </Huelle>
              {buch.mitgenommen && <p class="buch-text">{buch.mitgenommen}</p>}
            </li>
          );
        })}
      </Regal>
    )
  }
</Basis>

<style>
  .geschichte.mit-video {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(28px, 5cqi, 72px);
    align-items: center;
  }
  .motto-text {
    font-size: clamp(19px, 1.8cqi, 23px);
    line-height: 1.55;
  }

  /* Breite der Einträge je Regal. :global, weil die <section> aus Regal.astro kommt. */
  :global(.regal.zitate) {
    --breite: min(78vw, 320px);
  }
  :global(.regal.videos) {
    --breite: min(74vw, 300px);
  }
  :global(.regal.buecher) {
    --breite: 150px;
  }

  /* Zitate: Karten auf --flaeche, alle so hoch wie die höchste der Reihe */
  .zitat-karte {
    display: flex;
    flex-direction: column;
    gap: 14px;
    box-sizing: border-box;
    height: 100%;
    margin: 0;
    padding: 22px 22px 24px;
    border-radius: var(--r-gross);
    background: var(--flaeche);
  }
  .zitat-karte :global(.zitat-zeichen) {
    width: 22px;
    height: 22px;
    color: var(--orange);
  }
  .zitat {
    font-family: var(--lese);
    font-size: clamp(20px, 1.9cqi, 23px);
    line-height: 1.4;
    text-wrap: pretty;
  }
  .quelle {
    margin-top: auto;
    font-size: 14px;
    font-weight: 500;
    color: var(--leise);
  }

  /* Videos und Reden: ruhige dunkle Flächen wie das große Video, ohne Vorschaubild von YouTube */
  .videokarte {
    display: block;
    text-decoration: none;
  }
  .videokarte-flaeche {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-sizing: border-box;
    aspect-ratio: 16 / 10;
    padding: 16px 18px 18px;
    border-radius: var(--r);
    background: #1b1b1a;
    color: #ffffff;
    transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .videokarte-icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #ffffff;
    color: #1b1b1a;
  }
  .videokarte-icon :global(.icon) {
    width: 18px;
    height: 18px;
  }
  .videokarte-titel {
    display: -webkit-box;
    overflow: hidden;
    font-weight: 600;
    font-size: 17px;
    line-height: 1.3;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }
  .videokarte-von {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
    font-size: 14px;
    color: var(--leise);
  }
  .videokarte :global(.videokarte-extern) {
    width: 15px;
    height: 15px;
  }
  @media (hover: hover) {
    .videokarte:hover .videokarte-flaeche {
      transform: translateY(-3px);
    }
    .videokarte:hover .videokarte-von {
      color: var(--text);
    }
  }
  .videokarte-warum {
    margin-top: 8px;
    font-family: var(--lese);
    font-size: 16px;
    line-height: 1.5;
  }

  /* Bücher: typografische Cover, am Handy etwa zweieinhalb nebeneinander */
  .buch-huelle {
    display: block;
    text-decoration: none;
  }
  .buch-cover {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-sizing: border-box;
    aspect-ratio: 2 / 3;
    padding: 18px 16px 16px 22px;
    border-radius: 4px 10px 10px 4px;
    transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .buch :global(.buch-bild) {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border-radius: 4px 10px 10px 4px;
  }
  @media (hover: hover) {
    a.buch-huelle:hover .buch-cover,
    a.buch-huelle:hover :global(.buch-bild) {
      transform: translateY(-4px);
    }
  }
  /* Feine Falz links, wie beim echten Buch */
  .buch-cover::before {
    content: '';
    position: absolute;
    left: 9px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: currentColor;
    opacity: 0.14;
  }
  .buch-cover.dunkel {
    background: #373634;
    color: #f5f5f3;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  }
  .buch-cover.papier {
    background: #ece8e1;
    color: #373634;
  }
  .buch-cover-titel {
    font-family: var(--lese);
    font-weight: 600;
    font-size: 19px;
    line-height: 1.15;
    text-wrap: balance;
  }
  .buch-cover-autor {
    font-size: 12px;
    font-weight: 500;
    opacity: 0.75;
  }
  .buch-name {
    display: block;
    margin-top: 14px;
  }
  .buch-titel {
    display: block;
    font-weight: 600;
    font-size: 16px;
    line-height: 1.3;
  }
  .buch-autor {
    display: block;
    margin-top: 2px;
    font-size: 14px;
    color: var(--leise);
  }
  .buch-text {
    margin-top: 12px;
    font-family: var(--lese);
    font-size: 16px;
    line-height: 1.5;
  }

  @container (max-width: 760px) {
    .geschichte.mit-video {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
