---
import { getEntry } from 'astro:content';
import Basis from '../layouts/Basis.astro';
import Textseite from '../components/Textseite.astro';

const seite = await getEntry('seiten', 'datenschutz');
if (!seite) throw new Error('src/content/seiten/datenschutz.md fehlt.');
---

<Basis titel={seite.data.titel}>
  <Textseite seite={seite} />
</Basis>
