---
// Beitragsseite wie eine Notion-Seite: Titelbild als Cover, darunter das Icon des Bereichs, Zurück-Link,
// Titel, Tags, Fakten (Status, Datum, Brixmap), Story, Updates, Galerie, „Mehr aus …“.
// Leere Teile erscheinen gar nicht, auch nicht ihre Überschrift.
import { render } from 'astro:content';
import Basis from '../../layouts/Basis.astro';
import Cover from '../../components/Cover.astro';
import Foto from '../../components/Foto.astro';
import Galerie from '../../components/Galerie.astro';
import Icon from '../../components/Icon.astro';
import Projektliste from '../../components/Projektliste.astro';
import {
  BEREICH_ICONS,
  STATUS,
  beitraege,
  beitragsOrtId,
  bereiche,
  datum,
  isoDatum,
  klartext,
  kurz,
  teilbild,
  type Beitrag,
  type Bereich,
} from '../../lib/inhalt';

export async function getStaticPaths() {
  const alle = await beitraege();
  const alleBereiche = await bereiche();
  return alle.map((beitrag) => ({
    params: { bereich: beitrag.data.bereich, slug: beitrag.id },
    props: {
      beitrag,
      bereich: alleBereiche.find((b) => b.id === beitrag.data.bereich)!,
      mehr: alle.filter((b) => b.data.bereich === beitrag.data.bereich && b.id !== beitrag.id).slice(0, 3),
    },
  }));
}

interface Props {
  beitrag: Beitrag;
  bereich: Bereich;
  mehr: Beitrag[];
}

const { beitrag, bereich, mehr } = Astro.props;
const { titel, tags, status, titelbild, titelbild_alt, bildunterschrift, galerie, mitnehmen, orte } = beitrag.data;
const { Content } = await render(beitrag);
const hatStory = Boolean(beitrag.body?.trim());
const updates = [...beitrag.data.updates].sort((a, b) => b.datum.getTime() - a.datum.getTime());
// Das längste Wort bestimmt, wie groß der Titel höchstens sein darf (.beitrag-titel in global.css)
const laengstes = Math.max(...titel.split(/\s+/).map((wort) => wort.length));

const story = klartext(beitrag.body);
const beschreibung = story && !story.startsWith('[') ? kurz(story) : undefined;
---

<Basis titel={titel} beschreibung={beschreibung} bild={await teilbild(titelbild)} typ="article" abstand={mehr.length === 0}>
  <article>
    {titelbild && <Cover bild={titelbild} alt={titelbild_alt} unterschrift={bildunterschrift} />}
    <div class:list={['beitrag-kopf', 'rahmen', { 'mit-cover': titelbild }]}>
      <span class:list={['seiten-icon', { 'auf-cover': titelbild }]} aria-hidden="true">
        <Icon name={BEREICH_ICONS[bereich.id] ?? 'projekte'} />
      </span>
      <a class="zurueck" href={`/${bereich.id}/`}><span class="nur-sr">Zurück zu </span>{bereich.data.titel}</a>
      <h1 class="beitrag-titel" style={`--laengstes: ${laengstes}`}>{titel}</h1>
      {tags.length > 0 && <p class="tags">{tags.join(', ')}</p>}
      <dl class="fakten">
        {
          status && (
            <div>
              <dt>Status</dt>
              <dd class={status}>
                <span class="status-punkt" />
                {STATUS[status]}
              </dd>
            </div>
          )
        }
        <div>
          <dt>Datum</dt>
          <dd><time datetime={isoDatum(beitrag.data.datum)}>{datum(beitrag.data.datum)}</time></dd>
        </div>
        {
          orte.length > 0 && (
            <div>
              <dt>Auf der Brixmap</dt>
              <dd class="orte">
                {orte.map((ort, i) => (
                  <a href={`/brixmap/?ort=${beitragsOrtId(beitrag.id, i)}`}>{ort.name}</a>
                ))}
              </dd>
            </div>
          )
        }
      </dl>
    </div>

    {
      (hatStory || mitnehmen || updates.length > 0 || galerie.length > 0) && (
        <div class="rahmen">
          <div class="lesen story">
            {hatStory && (
              <div class="text">
                <Content />
              </div>
            )}

            {mitnehmen && (
              <aside class="mitnehmen" aria-label="Zum Mitnehmen">
                <p class="mitnehmen-titel">
                  <span class="punkt" aria-hidden="true" />
                  Zum Mitnehmen
                </p>
                <p class="mitnehmen-text">{mitnehmen}</p>
              </aside>
            )}

            {updates.length > 0 && (
              <>
                <h2 class="zwischentitel">Updates</h2>
                <ol class="liste updates">
                  {updates.map((update, i) => (
                    <li>
                      <p class="update-datum">
                        {i === 0 && <span class="neu" aria-hidden="true" />}
                        <time datetime={isoDatum(update.datum)}>{datum(update.datum)}</time>
                      </p>
                      <p class="update-text">{update.text}</p>
                      {update.bild && (
                        <Foto
                          bild={update.bild}
                          alt={update.bild_alt}
                          breiten={[680, 1360]}
                          sizes="(max-width: 760px) 92vw, 680px"
                          class="update-bild"
                        />
                      )}
                    </li>
                  ))}
                </ol>
              </>
            )}

            {galerie.length > 0 && (
              <>
                <h2 class="zwischentitel">Bilder</h2>
                <Galerie bilder={galerie} />
              </>
            )}
          </div>
        </div>
      )
    }
  </article>

  {
    mehr.length > 0 && (
      <section class="mehr rahmen" aria-labelledby="mehr-titel">
        <h2 class="zwischentitel" id="mehr-titel">
          Mehr aus {bereich.data.titel}
        </h2>
        <Projektliste beitraege={mehr} />
      </section>
    )
  }
</Basis>
